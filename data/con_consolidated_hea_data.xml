  <record id="server_action_1413_imp_copy_consignment_lines_to_consolidation" model="ir.actions.server">
    <field name="name">IMP - Copy Consignment Lines to Consolidation</field>
    <field name="model_id" search="[('model', '=', 'con_consolidated_hea')]"/>
    <field name="state">code</field>
    <field name="code"><![CDATA[if record.id:
  con_lines=[]
  
  con_header = env['consignment_header'].search([('status', '!=', 'Draft'), ('consolidated', '=', False)])
  if con_header:
    for validate_lines in con_header:
      con_lines.append([0,0,{
        'consignment_id':validate_lines.id,
        'container_no':validate_lines.container_no,
        'accounting_currency_id':validate_lines.accounting_currency_id.id,
        'custom_clearance_no':validate_lines.custom_clearance_no,
        'delivery_term':validate_lines.delivery_term.id,
        'accounting_invoice_date':validate_lines.accounting_invoice_date,
        'shipment_start_date':validate_lines.shipment_start_date,
        'shipping_mode':validate_lines.shipping_mode,
        'supplier_invoice_no':validate_lines.supplier_invoice_number,
        'supplier_id':validate_lines.supplier_id.id,
        'status':validate_lines.status}])

  ctx = env.context
  ctx.update({'default_consolidated_header_id':record.id,'default_con_lines':con_lines})
  action = {
            'name': 'Copy PIs',
            'type': 'ir.actions.act_window',
            'res_model': 'temp_con_consolidate',
            'view_mode': 'form',
            'view_type': 'form',
            'target': 'new',
            'context': ctx,
            }]]></field>
    <field name="usage">ir_actions_server</field>
  </record>
