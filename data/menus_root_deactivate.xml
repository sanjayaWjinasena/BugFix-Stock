<?xml version="1.0" encoding="utf-8"?>
<!-- Deactivate misplaced root menus. CDB is Known Good; -->
<!-- these were either duplicates of nested menus or Studio scratch never on CDB. -->
<odoo>
  <data>
    <!-- Tariffs Master (Studio scratch — not on CDB) -->
    <record id="menu_f6_tariffs_master" model="ir.ui.menu">
      <field name="active" eval="False"/>
    </record>
    <!-- Consignment Line (Studio scratch — not on CDB) -->
    <record id="menu_f6_consignment_line" model="ir.ui.menu">
      <field name="active" eval="False"/>
    </record>

    <!-- ============================================================
         v0.0.96 Purchase-app cleanup companion to BugFix-Purchase v161.
         Kill Stock-owned menus that duplicate BugFix-Purchase-owned
         twins OR are misplaced at Purchase-app root on Dev.
    ============================================================ -->

    <!-- Reporting > Custom Duty duplicate (menu_1075_* is the CDB-matching twin) -->
    <record id="menu_f6_custom_duty" model="ir.ui.menu">
      <field name="active" eval="False"/>
    </record>

    <!-- 'Imports - 01' misplaced root (BugFix-Studio-Misc.menu_f6r3_purchase_imports
         is the correct Imports dropdown; this was an old Stock port stub) -->
    <record id="menu_f6_imports_01" model="ir.ui.menu">
      <field name="active" eval="False"/>
    </record>

    <!-- 'Tariff Master' misplaced root (CDB has Tariff Master nested inside
         Configuration > Imports Configurations > Tariff subtree) -->
    <record id="menu_f6_tariff_master" model="ir.ui.menu">
      <field name="active" eval="False"/>
    </record>

    <!-- 'Setups' — huge Studio-routing extract subtree under Configuration
         with no counterpart on CDB. Deactivating the root hides the whole
         subtree (Import Charges, Structures, Tariffs, Delivery Terms,
         Charges, Misc Charges, Imports Ledger Setup, Custom Currency Rates
         and 15+ deeper leaves). -->
    <record id="menu_f6_setups" model="ir.ui.menu">
      <field name="active" eval="False"/>
    </record>

    <!-- ============================================================
         v0.0.97 Inventory-app cleanup: kill 'Inventory > Inventory
         Setup > Location' duplicate owned by this repo. menu_1150_
         location (from_routing, action_2470_location) is the CDB-
         matching twin — keep. menu_f6_location (act_window_2470_
         location, older f6 stub, same parent + name) is the dup.
    ============================================================ -->
    <record id="menu_f6_location" model="ir.ui.menu">
      <field name="active" eval="False"/>
    </record>
  </data>
</odoo>