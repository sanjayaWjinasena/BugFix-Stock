<odoo>

  <record id="base_automation_104_supplier_invoice_no_update_in_import_pos" model="base.automation">
    <field name="name">Supplier Invoice No Update in Import POs</field>
    <field name="active" eval="True"/>
    <field name="model_id" search="[('model', '=', 'stock.picking')]"/>
    <field name="trigger">on_change</field>
    <field name="on_change_field_ids" eval="[(6, 0, [ref('BugFix-Stock.field_stock_picking__x_studio_consignment_no')])]"/>
    <field name="action_server_ids" eval="[(6, 0, [ref('BugFix-Stock.server_action_1697_supplier_invoice_no_update_in_import_pos')])]"/>
  </record>

