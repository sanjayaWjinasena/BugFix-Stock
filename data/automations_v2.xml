  <record id="base_automation_199_proj_notify_transfer_completion" model="base.automation">
    <field name="name">PROJ - Notify Transfer Completion</field>
    <field name="active" eval="True"/>
    <field name="model_id" search="[('model', '=', 'stock.picking')]"/>
    <field name="trigger">on_create_or_write</field>
    <field name="filter_pre_domain">[('state', '!=', 'done')]</field>
    <field name="filter_domain">[('sale_id.x_studio_quotation_type', '=', 'Project'), ('state', '=', 'done')]</field>
    <field name="action_server_ids" eval="[(6, 0, [ref('BugFix-Stock.server_action_2185_proj_notify_transfer_completion')])]"/>
  </record>

