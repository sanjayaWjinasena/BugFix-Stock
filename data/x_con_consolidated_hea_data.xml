  <record id="server_action_1414_imp_clear_consignment_lines_from_consolidation" model="ir.actions.server">
    <field name="name">IMP - Clear Consignment Lines from Consolidation</field>
    <field name="model_id" search="[('model', '=', 'x_con_consolidated_hea')]"/>
    <field name="state">code</field>
    <field name="code"><![CDATA[if record.id:
  temp_rec = env['x_con_consolidated_lin'].search([('x_studio_consolidated_header_id', '=', record.id)])
  if temp_rec:
    for del_temp_rec in temp_rec:
      con_update = env['x_consignment_header'].search([('id', '=', del_temp_rec.x_studio_consignment_id.id)],limit=1)
      if con_update:
        con_update.write({'x_studio_consolidated': False}) 
      
      del_temp_rec.unlink()   

    record['x_studio_lines_copied'] = False]]></field>
    <field name="usage">ir_actions_server</field>
  </record>
