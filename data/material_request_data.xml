  <record id="action_pr_create_for_mr" model="ir.actions.server">
    <field name="name">PR create For MR</field>
    <field name="model_id" search="[('model', '=', 'material_request')]"/>
    <field name="state">code</field>
    <field name="usage">ir_actions_server</field>
    <field name="binding_view_types">list,form</field>
    <field name="code"><![CDATA[pr_lines=[]

for pr_line in record.one2many_field_9DTZS:

  pr_lines.append([0,0,{'many2one_field_WAqP4':pr_line.many2one_field_2LV9q.id,'quantity':pr_line.qty}])

env['purchase_request'].create({'mr_number':record.name,'material_request_ref':record.id,'type':record.type, 'order_lines_1':pr_lines})


]]></field>
