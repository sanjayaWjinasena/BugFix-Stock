  <record id="action_confirm_mr" model="ir.actions.server">
    <field name="name">Confirm MR</field>
    <field name="model_id" search="[('model', '=', 'material_request')]"/>
    <field name="state">code</field>
    <field name="usage">ir_actions_server</field>
    <field name="binding_view_types">list,form</field>
    <field name="code"><![CDATA[if record.name:
  null_Mr_lines = env['mr_config'].search([('many2one_field_6yqbk', '=', record.name)])
  if not null_Mr_lines:
   raise UserError("Valid MR Lines Should Exists to Confirm!")
   
  invalid_mr_lines = env['mr_config'].search([('many2one_field_6yqbk', '=', record.name), ('quantity', '<=', 0)])
  if invalid_mr_lines:
    raise UserError("Quantity of Individual MR Lines Should be Greater than Zero!")
    
record.write({'selection_field_BupKG': 'Confirmed'}) 
]]></field>
  </record>
  <record id="action_create_material_transfer" model="ir.actions.server">
    <field name="name">Create Material Transfer</field>
    <field name="model_id" search="[('model', '=', 'material_request')]"/>
    <field name="state">code</field>
    <field name="usage">ir_actions_server</field>
    <field name="binding_view_types">list,form</field>
    <field name="code"><![CDATA[valid_req_lines = env['mr_config'].search([('many2one_field_6yqbk', '=', record.id),('transfer_remainder', '>', 0)],limit=1)

if not valid_req_lines:

  raise UserError('There are no valid item lines to transfer.')

  

dest_loc = env['stock.location'].search([('usage', '=', 'inventory'),('complete_name', '=', 'Virtual Locations/MJ')],limit=1)

if dest_loc:

  opt_type = env['stock.picking.type'].search([('default_location_src_id', '=', record.warehouse.id),('default_location_dest_id', '=', dest_loc.id),('code', '=', 'outgoing')],limit=1)

  if opt_type:

    prod_move = env['stock.picking'].create({'created_from_material_request_no':record.id,'picking_type_id':opt_type.id,'location_id':record.warehouse.id,'location_dest_id':dest_loc.id,'journal_type':record.journal_type.id})

     

    update_prod_move = env['stock.picking'].search([('id', '=', prod_move.id)],limit=1)

    if update_prod_move:

      valid_req_lines_2 = env['mr_config'].search([('many2one_field_6yqbk', '=', record.id),('transfer_remainder', '>', 0)])

      if valid_req_lines_2:

        for valid_lines in valid_req_lines_2: 

          stock_move = env['stock.move'].create({'picking_id':update_prod_move.id,'name':('New Move:'+valid_lines.product.name),'reference':update_prod_move.name,'picking_type_id':update_prod_move.picking_type_id.id,'product_id':valid_lines.product.id,'location_id':update_prod_move.location_id.id,'location_dest_id':update_prod_move.location_dest_id.id,'product_uom_qty':valid_lines.qty_to_transfer,'product_uom':valid_lines.product.uom_id.id,'state':'draft'}) 

          stock_move_line = env['stock.move.line'].create({'move_id':stock_move.id,'picking_id':update_prod_move.id,'picking_type_id':update_prod_move.picking_type_id.id,'product_id':valid_lines.product.id,'product_uom_id':valid_lines.product.uom_id.id,'location_id':update_prod_move.location_id.id,'location_dest_id':update_prod_move.location_dest_id.id,'qty_done':valid_lines.qty_to_transfer}) 



          #cal = 0

          #if valid_lines.available_qty_to_transfer

          #cal = 

          valid_lines.write({'qty_transfered': (valid_lines.qty_transfered + valid_lines.qty_to_transfer), 'qty_to_transfer': 0}) #valid_lines.available_qty_to_transfer 

    action = {

              'name': 'RFQ',

              'domain': [('id', '=', prod_move.id)],

              'type': 'ir.actions.act_window',

              'res_model': 'stock.picking',

              'view_mode': 'tree,form',

              'view_type': 'form',

              'view_id': False,

              'context': False,

              } 

  else:

    raise UserError('There is no valid operation type has been setup.')  

else:

  raise UserError('There is no valid Location has been setup.')  



]]></field>
  </record>
