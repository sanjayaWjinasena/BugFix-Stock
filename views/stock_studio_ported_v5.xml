<?xml version="1.0" encoding="utf-8"?>
<!--
    BugFix-Stock v0.0.25 (retry #2): views 2811 + 2816 for x_consignment_header.

    First attempt (c68189d) crashed on undeclared modifier fields;
    fixed by injecting 5 sentinels (2811 loaded fine at second attempt).
    Second attempt (22c6de3) got past 2811 but crashed on 2816
    referencing x_studio_consignment_line_ids which was TODO on-disk
    in models/x_consignment_header.py.

    This retry ports the missing O2M in the same commit:
      x_studio_consignment_line_ids = fields.One2many(
          'x_consignment_line',
          'x_studio_consignment_header_id',
          string='Consignment Line Ids')
    (spec verified via RPC from Clear-DB).

    2811 primary form: same as second attempt (5 sentinels, chatter
    stripped, 11 numeric refs interpolated).

    2816 Studio inherit: same as second attempt (1383 button stripped,
    5 numeric refs interpolated). Now x_studio_consignment_line_ids
    resolves on the model.
-->
<odoo>

    <record id="ported_view_2811_default_form_view_for_x_consignment_header" model="ir.ui.view">
        <field name="name">Default form view for x_consignment_header</field>
        <field name="model">x_consignment_header</field>
        <field name="type">form</field>
        <field name="priority">16</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
              <header>  
                <button type="action" name="%(BugFix-Stock.server_action_1263_imp_copy_po_lines_to_consignment)d" string="Copy PO Lines" class="btn-primary" invisible="x_studio_status not in ['Draft']"/>
                <button type="action" name="%(BugFix-Stock.server_action_1303_imp_clear_po_lines_from_consignment)d" string="Clear PO Lines" class="btn-primary" invisible="(x_studio_status not in ['Draft']) or (x_studio_lines_copied == False)"/>
                <button type="action" name="%(BugFix-Stock.server_action_1365_imp_confirm_purchase_invoice)d" string="Confirm Invoice" class="btn-primary" invisible="(x_studio_status not in ['Draft']) or (x_studio_lines_copied == False)"/>
                <button type="action" name="%(BugFix-Stock.server_action_1456_imp_validate_consolidation_in_consignment)d" string="Validate Consolidation" class="btn-primary" invisible="x_studio_status not in ['Consignment']"/>
                <button type="action" name="%(BugFix-Stock.server_action_1305_imp_consignment_vendor_despatch)d" string="Vendor Dispatch" class="btn-primary" invisible="x_studio_status not in ['Consolidated']"/>
                <button type="action" name="%(BugFix-Stock.server_action_1313_imp_consignment_port_receipt)d" string="Port Receipt" class="btn-primary" invisible="x_studio_status not in ['In Transit']"/>
                <button type="action" name="%(BugFix-Stock.server_action_2199_imp_reset_header_charges_consignment)d" string="Reset Header Charges" class="btn-primary" invisible="((x_studio_allocate_header_charges == True) and (x_studio_create_header_charges == True)) or ((x_studio_header_charges_allocated == False) or (x_studio_status in ['Done', 'TP Invoice']))"/>
                <button type="action" name="%(BugFix-Stock.server_action_1316_imp_create_consignment_header_charges)d" string="Create Header Charges" class="btn-primary" invisible="(x_studio_create_header_charges == False) or (x_studio_status not in ['Under Custom Clearance'])"/>
                <button type="action" name="%(BugFix-Stock.server_action_1318_imp_allocate_consignment_header_charges)d" string="Allocate Header Charges" class="btn-primary" confirm="Are you sure you want to allocate header charges?" invisible="((x_studio_allocate_header_charges == True) and (x_studio_create_header_charges == True)) or ((x_studio_allocate_header_charges == False) or (x_studio_status not in ['Under Custom Clearance']))"/>
                <button type="action" name="%(BugFix-Stock.server_action_1321_imp_consignment_custom_duty)d" string="Custom Duty" class="btn-primary" invisible="((x_studio_allocate_header_charges == True) and (x_studio_create_header_charges == True)) or ((x_studio_allocate_header_charges == True) or (x_studio_status not in ['Under Custom Clearance']))"/>
                <button type="action" name="%(BugFix-Stock.server_action_1377_imp_copy_charges_to_tp_invoice)d" string="Process TP Invoice" class="btn-primary" invisible="x_studio_status not in ['Done', 'TP Invoice']"/>
              </header>
              <header/>
              <sheet string="Consignment Header">
                <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
                <field name="x_active" invisible="1"/>
                <!-- v0.0.25: sentinel fields for Odoo 17 strict-validation modifiers -->
                <field name="x_studio_status" invisible="1"/>
                <field name="x_studio_lines_copied" invisible="1"/>
                <field name="x_studio_allocate_header_charges" invisible="1"/>
                <field name="x_studio_create_header_charges" invisible="1"/>
                <field name="x_studio_header_charges_allocated" invisible="1"/>
                <div class="oe_title">
                            <span class="o_form_label">Invoice Reference</span>
                            <h1>
                                <field name="x_name" required="1" placeholder="Name..."/>
                            </h1>
                        </div>
                <group name="studio_group_01a9e3">
                  <group name="studio_group_01a9e3_left"/>
                  <group name="studio_group_01a9e3_right"/>
                </group>
              </sheet>
              <!-- v0.0.25: oe_chatter block stripped -->
            </form>
        </field>
    </record>

    <record id="ported_view_2816_studio_form_x_consignment_header" model="ir.ui.view">
        <field name="name">Odoo Studio: Default form view for x_consignment_header customization</field>
        <field name="model">x_consignment_header</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="BugFix-Stock.ported_view_2811_default_form_view_for_x_consignment_header"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//button[@name='%(BugFix-Stock.server_action_1303_imp_clear_po_lines_from_consignment)d']" position="after">
                <field widget="statusbar" name="x_studio_status_bar" string="Status Bar" force_save="True" readonly="1"/>
              </xpath>
              <xpath expr="//form[1]/sheet[1]/widget[@name='web_ribbon']" position="before">
                <div name="button_box" class="oe_button_box">
                  <button class="oe_stat_button" icon="fa-folder-open" type="action" name="%(BugFix-Stock.act_1306_vendor_despatch)d" invisible="x_x_studio_created_from_consignment__account_move_count == 0">
                    <field widget="statinfo" name="x_x_studio_created_from_consignment__account_move_count" string="Vendor Despatch"/>
                  </button>
                  <button class="oe_stat_button" icon="fa-briefcase" type="action" name="%(BugFix-Stock.action_1317_header_charges)d" invisible="x_x_studio_consignment_id__x_consignment_charge_h_count == 0">
                    <field widget="statinfo" name="x_x_studio_consignment_id__x_consignment_charge_h_count" string="Header Charges"/>
                  </button>
                  <button class="oe_stat_button" icon="fa-briefcase" type="action" name="%(BugFix-Stock.action_1319_line_charges)d" invisible="x_x_studio_consignment_id__x_consignment_charge_l_count == 0">
                    <field widget="statinfo" name="x_x_studio_consignment_id__x_consignment_charge_l_count" string="Line Charges"/>
                  </button>
                  <button class="oe_stat_button" icon="fa-folder-open" type="action" name="%(BugFix-Stock.act_1322_custom_clearance)d" invisible="x_x_studio_created_from_consignment_1__account_move_count == 0">
                    <field widget="statinfo" name="x_x_studio_created_from_consignment_1__account_move_count" string="Custom Clearance"/>
                  </button>
                  </div>
              </xpath>
              <xpath expr="//field[@name='x_name']" position="attributes">
                <attribute name="force_save">True</attribute>
                <attribute name="placeholder">New</attribute>
                <attribute name="string">Consignment Reference</attribute>
              <attribute name="readonly">1</attribute><attribute name="required"/></xpath>
              <xpath expr="//group[@name='studio_group_01a9e3_left']" position="inside">
                <field name="x_studio_description" string="Description" invisible="1" readonly="x_studio_status != 'Draft'"/>
                <field name="x_studio_supplier_id" string="Vendor" options="{&quot;no_create&quot;:true}" required="1" readonly="x_studio_status != 'Draft'"/>
                <field name="x_studio_currency_id" required="1" readonly="x_studio_status != 'Draft'"/>
                <field name="x_studio_delivery_term" string="Delivery Term" required="1" help="Delivery Term or the Incoterm." readonly="x_studio_status != 'Draft'"/>
                <field name="x_studio_supplier_invoice_number" string="Supplier's Invoice No (Bill Reference)" required="1" help="Invoice number of the main supplier's invoice." readonly="x_studio_status != 'Draft'"/>
                <field name="x_studio_invoice_date" string="Supplier's Invoice Date (Bill Date)" required="1" readonly="x_studio_status != 'Draft'"/>
                <field name="x_studio_shipment_start_date" readonly="x_studio_status != 'Draft'"/>
                <field name="x_studio_voucher_date" string="Vendor Dispatch Voucher Date" help="The date which the Vendor Dispatch Voucher to be posted on." readonly="(x_studio_status == 'TP Invoice') or ((x_studio_status == 'Done') or ((x_studio_status == 'Under Custom Clearance') or (x_studio_status == 'In Transit')))" required="x_studio_status == 'Consolidated'"/>
              </xpath>
              <xpath expr="//group[@name='studio_group_01a9e3_right']" position="inside">
                <field name="x_studio_container_no" string="Container No" readonly="x_studio_status != 'Draft'"/>
                <field name="x_studio_shipping_mode" string="Shipping Mode" readonly="x_studio_status != 'Draft'"/>
                <field name="x_studio_custom_clearance_no" string="Custom Clearance No" force_save="True" readonly="1" invisible="x_studio_custom_clearance_no == False"/>
                <field name="create_uid" invisible="create_uid == False"/>
                <field name="create_date" invisible="create_date == False"/>
                <field name="x_studio_status" string="Status" force_save="True" readonly="1"/>
                <field name="x_studio_cost_allocation_method" string="Cost Allocation Method" force_save="True" readonly="1" help="The method of allocating the assessable value and the charges to each line to calculate duties and taxes."/>
                <field name="x_studio_consolidated" string="Consolidated" force_save="True" readonly="1" invisible="1"/>
                <field name="x_studio_consolidation_confirmed" string="Consolidation Confirmed" force_save="True" readonly="1" invisible="1"/>
                <field name="x_studio_con_validated" string="Con. Validated" force_save="True" readonly="1" invisible="1"/>
                <field name="x_studio_offset_account" string="Offset Account" force_save="True" readonly="1" invisible="1"/>
                <field name="x_studio_account_tax" string="Account Tax" force_save="True" readonly="1" invisible="1"/>
                <field name="x_studio_account_duty" string="Account Duty" force_save="True" readonly="1" invisible="1"/>
                <field name="x_studio_account_charge" string="Account Charge" force_save="True" readonly="1" invisible="1"/>
                <field name="x_studio_custom_clearance_exchange_rate" string="Custom Clearance Exchange Rate"/>
                <field name="x_studio_custom_clearance" string="Custom Clearance" invisible="1"/>
                <field name="x_studio_vend_dispatch_status" string="Vend. Dispatch Status" force_save="True" readonly="1" invisible="x_studio_vend_dispatch_status == False"/>
                <field name="x_studio_vendor_dispatch_exchange_rate" string="Vendor Dispatch Exchange Rate"/>
                <field name="x_studio_company_id" string="Company" force_save="True" readonly="1" invisible="1"/>
                <field name="x_studio_vendor_dispatch" string="Vendor Dispatch" invisible="1"/>
                <field name="x_studio_allocate_header_charges" string="Allocate Header Charges" invisible="1"/>
                <field name="x_studio_header_charges_allocated" string="Header Charges Allocated" invisible="1"/>
                <field name="x_studio_create_header_charges" string="Create Header Charges" invisible="1"/>
                <field name="x_studio_lines_copied" string="Lines Copied" force_save="True" readonly="1" invisible="1"/>
                <field name="x_studio_confirm_invoice" string="Confirm Invoice" force_save="True" readonly="1" invisible="1"/>
                <field name="x_studio_total_amount_cost_allocation_method" string="Total Amount Cost Allocation Method" invisible="1"/>
              </xpath>
              <xpath expr="//group[@name='studio_group_01a9e3']" position="after">
                <notebook name="studio_notebook_TKzcl">
                  <page string="Lines" name="studio_page_TKzcl">
                    <field name="x_studio_consignment_line_ids" string="Consignment Line Ids" readonly="(x_studio_header_charges_allocated == True) or (x_studio_status != 'Draft')">
                      <tree editable="bottom" create="false">
                        <field name="x_studio_sequence" widget="handle" column_invisible="1"/>
                        <field name="x_studio_purchase_id" force_save="True" readonly="1"/>
                        <field name="x_studio_product_id" force_save="True" readonly="1"/>
                        <field name="x_studio_description"/>
                        <field name="x_studio_tariff_code"/>
                        <field name="x_studio_warehouse"/>
                        <field name="x_studio_invoice_qty"/>
                        <field name="x_studio_weight" string="Weight" column_invisible="parent.x_studio_cost_allocation_method != 'by_weight'"/>
                        <field name="x_studio_volume" string="Volume" column_invisible="parent.x_studio_cost_allocation_method != 'by_volume'"/>
                        <field name="x_studio_unit_price" force_save="True" readonly="1"/>
                        <field name="x_studio_amount"/>
                        <field optional="show" name="x_studio_original_delivery_remainder" string="Original Delivery Remainder" column_invisible="1"/>
                        <field name="x_studio_exchange_rate" string="Exchange Rate" force_save="True" readonly="1" column_invisible="1"/>
                        <field name="x_studio_structure_name" string="Structure Name" column_invisible="1"/>
                        <field name="x_studio_allocate_amount" string="Allocate Amount" force_save="True" readonly="1" column_invisible="1"/>
                        <field name="x_studio_cost_allocation_method" string="Cost Allocation Method" column_invisible="1"/>
                        <field name="x_studio_payment_method" string="Payment Method" force_save="True" readonly="1" optional="hide"/>
                        <field name="x_studio_stock_move_id" string="Stock Move Id" force_save="True" readonly="1" column_invisible="1"/>
                        <field name="x_studio_valid_tax" string="Valid Tax" column_invisible="1"/>
                        <field name="x_studio_valid_duty" string="Valid Duty" column_invisible="1"/>
                        <field name="x_studio_valid_charge" string="Valid Charge" column_invisible="1"/>
                        <field name="x_studio_tot_tax" string="Tot Tax" column_invisible="1"/>
                        <field name="x_studio_tot_duty" string="Tot Duty" column_invisible="1"/>
                        <field name="x_studio_tot_charge" string="Tot Charge" force_save="True" column_invisible="1"/>
                        <field name="x_studio_concessional_rate" string="Concessional Rate" widget="boolean_toggle" force_save="True" readonly="1" optional="hide"/>
                        <field name="x_studio_purchase_line_id" string="Purchase Line Id" readonly="1" column_invisible="1"/>
                        <field name="x_studio_delivery_remainder" string="Delivery Remainder" optional="hide"/>
                        <field name="x_studio_received_qty" optional="hide" column_invisible="1"/>
                        <field name="x_studio_order_remainder" optional="hide"/>
                        <field name="x_currency_id" optional="hide"/>
                        <field name="x_studio_status" optional="hide"/>
                        <field name="x_studio_tot_charge_cd_ids" optional="show" column_invisible="1"/>
                        <field name="x_studio_tot_charge_ex_ids" optional="show" widget="many2many_tags"/>
                        <field name="x_studio_tot_duty_ex_cd_ids" optional="show" widget="many2many_tags" column_invisible="1"/>
                        <field name="x_studio_tot_tax_ex_cd_ids" optional="show" widget="many2many_tags" column_invisible="1"/>
                        <field name="x_studio_tot_charge_ex_cd_ids" optional="show" widget="many2many_tags" column_invisible="1"/>
                        <field name="x_name" column_invisible="1"/>
                        <field name="x_studio_header_charges_allocated" optional="hide" string="Header Charges Allocated" column_invisible="1"/>
                      </tree>
                      <form>
                        <header/>
                        <sheet string="Consignment Line" name="studio_sheet_527984">
                          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
                          <field name="x_active" invisible="1"/>
                          <div class="oe_title" name="studio_div_9afb5b">
                            <h1>
                              <field name="x_name" required="1" placeholder="Name..." invisible="1"/>
                            </h1>
                          </div>
                          <group name="studio_group_0644e6">
                            <group name="studio_group_0644e6_left">
                              <field name="x_studio_purchase_id"/>
                              <field name="x_studio_product_id"/>
                              <field name="x_studio_description" string="Description"/>
                              <field name="x_studio_warehouse" string="Warehouse"/>
                              <field name="x_studio_tariff_code" string="Tariff Code"/>
                              <field name="x_studio_consignment_header_id" string="Consignment Header Id" invisible="1"/>
                            </group>
                            <group name="studio_group_0644e6_right">
                              <field name="x_currency_id"/>
                              <field name="x_studio_invoice_qty" string="Invoice Qty."/>
                              <field name="x_studio_unit_price" string="Unit Price"/>
                              <field name="x_studio_amount" string="Amount"/>
                              <field name="x_studio_received_qty" string="Received Qty."/>
                              <field name="x_studio_order_remainder" string="Order Remainder" force_save="True" readonly="1"/>
                              <field name="x_studio_status" string="Status"/>
                            </group>
                          </group>
                        </sheet>
                      </form>
                    </field>
                    <group class="oe_subtotal_footer oe_right">
                      <field name="x_studio_total_amount" string="Total Amount"/>
                      <field name="x_studio_total_allocate_amount" string="Total Allocate Amount" force_save="True" readonly="1" invisible="1"/>
                    </group>
                  </page>
                  <page string="Import Details" name="studio_page_EFr4K">
                    <group name="studio_group_EFr4K">
                      <group name="studio_group_EFr4K_left" string="Import Details">
                        <field name="x_studio_structure_name" string="Structure Name" options="{&quot;no_create&quot;:true}" help="Imports Structure which contains formulas for duty and tax calculation of each item." readonly="x_studio_create_header_charges == False"/>
                        <field name="x_studio_custom_cleared_date" string="Custom Cleared Date" help="Date of custom clearance." readonly="x_studio_create_header_charges == False"/>
                      </group>
                    </group>
                  </page>
                  <page string="Import Documents - Prior Confirmation" name="studio_page_5gENM">
                    <group name="studio_group_5gENM">
                      <group name="studio_group_5gENM_left">
                        <field name="x_studio_supplier_document" widget="pdf_viewer" readonly="x_studio_status != 'Draft'"/>
                      </group>
                      <group name="studio_group_5gENM_right">
                        <field name="x_studio_packing_list" widget="pdf_viewer" readonly="x_studio_status != 'Draft'"/>
                      </group>
                    </group>
                  </page>
                  <page string="Import Documents - Prior Vendor Dispatch" name="studio_page_Motdk">
                    <group name="studio_group_Motdk">
                      <group name="studio_group_Motdk_left">
                        <field filename="x_studio_bill_of_lading_filename" name="x_studio_bill_of_lading" string="Bill of Lading" widget="pdf_viewer" readonly="(x_studio_status == 'In Transit') or ((x_studio_status == 'Under Custom Clearance') or ((x_studio_status == 'Done') or (x_studio_status == 'TP Invoice')))">
                          <field invisible="1" name="x_studio_bill_of_lading_filename"/>
                        </field>
                      </group>
                      <group name="studio_group_Motdk_right"/>
                    </group>
                  </page>
                  <page string="Import Documents - Prior Port Receipt" name="studio_page_9qKsI">
                    <group name="studio_group_9qKsI">
                      <group name="studio_group_9qKsI_left">
                        <field name="x_studio_cargo_arrival_notice" widget="pdf_viewer" readonly="(x_studio_status == 'Under Custom Clearance') or ((x_studio_status == 'Done') or (x_studio_status == 'TP Invoice'))"/>
                      </group>
                      <group name="studio_group_9qKsI_right"/>
                    </group>
                  </page>
                </notebook>
              </xpath>
            </data>
        </field>
    </record>

</odoo>
