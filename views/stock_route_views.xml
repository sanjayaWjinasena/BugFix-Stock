    <record id="ported_view_4866_studio_stock_route_tree" model="ir.ui.view">
        <field name="name">Odoo Studio: stock.location.route.tree customization</field>
        <field name="model">stock.route</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="stock.stock_location_route_tree"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//field[@name='sequence']" position="after">
                <field name="id" optional="show"/>
                <field name="product_ids" optional="show"/>
              </xpath>
              <xpath expr="//tree[1]/field[@name='name']" position="after">
                <field name="supplier_wh_id" optional="show"/>
                <field name="supplied_wh_id" optional="show"/>
              </xpath>
            </data>
        </field>
    </record>
</odoo>
