        <field name="priority">160</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//tree[1]" position="attributes">
                <attribute name="create">true</attribute>
              </xpath>
              <xpath expr="//field[@name='state']" position="after">
                <field name="movement_journal" optional="show" column_invisible="1"/>
                <field name="gl_account_status" optional="hide" widget="badge" invisible="movement_journal != True"/>
              </xpath>
            </data>
        </field>
    </record>
    <record id="view_stock_picking_form_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: stock.picking.form customization</field>
        <field name="model">stock.picking</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <data>
              <!-- Kapila -->
              <xpath expr="//button[@name='action_assign']" position="attributes">
                <attribute name="help">'Verify if the required products are available in stock. '</attribute>
              </xpath>
              <xpath expr="//button[@name='action_assign']" position="after">
                <button type="action" name="%(BugFix-Stock.action_imp_update_consignment_final)d" string="Update Consignment" class="btn-primary" invisible="(state == 'cancel') or (((update_consignment == True) and (pr_type == 'Import')) or ((pr_type == False) or (pr_type == 'Local')))"/>
              </xpath>
              <!-- Kapila -->
              <xpath expr="//form[1]/header[1]/button[@name='action_confirm']" position="attributes">
                <attribute name="help">The transfer order is ready to be processed, but the actual transfer has not been executed yet.
                </attribute>
              </xpath>
             <!-- Kapila -->
              <xpath expr="//form[1]/header[1]/button[@name='button_validate']" position="attributes">
                <attribute name="groups"/>
                <attribute name="help">Confirm or finalize the transaction</attribute>
              </xpath>
              <xpath expr="//form[1]/header[1]/button[@name='button_validate'][2]" position="attributes">
                <attribute name="help">Confirm or finalize the transaction</attribute>
              </xpath>
              <!-- Kapila -->
              <xpath expr="//button[@name='action_open_label_type']" position="attributes">
                <attribute name="studio_approval">True</attribute>
              </xpath>
              <xpath expr="//button[@name='%(stock.action_report_delivery)d']" position="attributes">
                <attribute name="groups">stock.group_stock_user</attribute>
              </xpath>
              <xpath expr="//button[@name='%(stock.action_report_delivery)d']" position="after">
                <button type="action" name="%(stock.act_stock_return_picking)d" string="Dispatch" invisible="((received_at_centre == False) and ((factory_repair == True) and (created_from_help_ticket != False))) or (((received_at_centre == False) and ((factory_repair == True) and (helpdesk_ticket_id != False))) or (((valid_factory_repair == False) and ((factory_repair == True) and (created_from_help_ticket != False))) or (((valid_factory_repair == False) and ((factory_repair == True) and (helpdesk_ticket_id != False))) or (((fsm_task_done == False) and (created_from_help_ticket != False)) or (((fsm_task_done == False) and (helpdesk_ticket_id != False)) or (((cancelled == False) and ((task_status == False) and (helpdesk_ticket_id != False))) or ((state != 'done') or ((helpdesk_ticket_id == False) or ((cash_full_payment_made == True) or ((fully_paid_so == False) or (picking_count == True)))))))))))"/>
                <button type="action" name="%(BugFix-Stock.action_rr_re_return_validation)d" string="Retun Reject Reason" class="btn-primary" invisible="((fsm_task_done == True) and (created_from_help_ticket != False)) or (((fsm_task_done == True) and (helpdesk_ticket_id != False)) or ((state != 'done') or ((helpdesk_ticket_id == False) or (cancelled == True))))"/>
              </xpath>
              <xpath expr="//form[1]/header[1]/button[@name='%(stock.act_stock_return_picking)d'][2]" position="attributes">
                <attribute name="invisible">(state != 'done') or (((task_status == False) and (helpdesk_ticket_id != False)) or ((state != 'done') or (helpdesk_ticket_id != False)))</attribute>
              </xpath>
              <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="studio_approval">True</attribute>
              </xpath>
              <xpath expr="//button[@name='%(stock.action_stock_report)d']" position="after">
                <button class="oe_stat_button" icon="fa-folder-open" type="action" name="%(BugFix-Stock.action_vend_dispatch_reversal)d" studio-view-group-names="User" studio-view-group-ids="81" invisible="created_from_transfer__account_move_count == 0">
                  <field widget="statinfo" name="created_from_transfer__account_move_count" string="Vend. Dispatch Reversal" studio-view-group-names="User" studio-view-group-ids="81"/>
                </button>
                <button class="oe_stat_button" icon="fa-folder-open" type="action" name="%(BugFix-Stock.action_custom_clearance_reversal)d" studio-view-group-names="User" studio-view-group-ids="81" invisible="create_from_transfer_1__account_move_count == 0">
                  <field widget="statinfo" name="create_from_transfer_1__account_move_count" string="Custom Clearance Reversal" studio-view-group-names="User" studio-view-group-ids="81"/>
                </button>
              </xpath>
              <xpath expr="//button[@name='action_view_stock_valuation_layers']" position="attributes">
                <attribute name="groups"/>
              </xpath>
              <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/field[@name='partner_id']" position="attributes">
                <attribute name="force_save">True</attribute>
                <attribute name="readonly">(state in ['cancel', 'done']) or ((pr_type == 'Import') or (state in ['done', 'cancel']))</attribute>
                <attribute name="required">(carrier_id and carrier_id.integration_level == 'rate_and_ship') or ((delivery_type not in ['fixed', 'base_on_rule']) and (delivery_type != False))</attribute>
              </xpath>
              <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/field[@name='picking_type_id']" position="attributes">
                <attribute name="domain">[["code","=",picking_type_code]]</attribute>
                <attribute name="help">Warehouse and the operation type.</attribute>
                <attribute name="invisible">(hide_picking_type) or (hide_picking_type == True)</attribute>
              </xpath>
              <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/field[@name='location_id']" position="attributes">
                <attribute name="domain">[]</attribute>
                <attribute name="invisible">picking_type_code == 'incoming'</attribute>
                <attribute name="readonly">(type_of_operation != 'internal') or ((picking_type_code == 'internal') or (state not in ['draft']))</attribute>
              </xpath>
              <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/field[@name='location_dest_id']" position="attributes">
                <attribute name="help">Destination Location.</attribute>
                <attribute name="invisible">picking_type_code == 'outgoing'</attribute>
                <attribute name="readonly">state not in ['draft']</attribute>
              </xpath>
              <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/field[@name='location_dest_id']" position="after">
                <field name="need_approval" string="Need Approval" invisible="1"/>
                <field name="helpdesk_ticket_id" string="Helpdesk Ticket Id" invisible="helpdesk_ticket_id == False"/>
                <field name="created_from_help_ticket" string="Created from Help Ticket" force_save="True" readonly="1" invisible="created_from_help_ticket == False"/>
                <field name="created_from_material_request_no" string="Created from Material Request No" force_save="True" readonly="1" invisible="created_from_material_request_no == False"/>
                <field name="cancelled" string="Cancelled" invisible="1"/>
                <field name="task_status" string="Task Status" invisible="1"/>
              </xpath>
              <xpath expr="//form[1]/sheet[1]/group[1]/group[2]/label[1]" position="before">
                <field name="sales_order" string="Sales Order" domain="[('partner_id', '=', partner_id)]" readonly="(partner_id == False) or (state != 'draft')"/>
              </xpath>
              <xpath expr="//field[@name='date_done']" position="after">
                <field name="purchase_id" help="Purchase Order Number which goods are to be received from." invisible="purchase_id == False"/>
                <field name="supplier_invoice_number" force_save="1" help="Invoice number of the supplier's invoice." invisible="purchase_id == False" readonly="(pr_type == 'Import') or (state == 'done')" required="purchase_id != False"/>
                <field name="supplier_invoice_number_1" string="Supplier Invoice Number" invisible="1" required="purchase_id != False"/>
                <field name="pr_type" string="PR Type" help="Whether the purchase is import or a local." invisible="(pr_type == False) or (pr_type == 'Local')"/>
                <field name="consignment_no" string="Consignment No" domain="[('status', '=', 'Done')]" help="Consignment number." invisible="(pr_type == False) or (pr_type == 'Local')" readonly="update_consignment == True" required="pr_type == 'Import'"/>
                <field name="custom_clearance_no" string="Custom Clearance No" help="Custom Clearance Number." invisible="(pr_type == False) or (pr_type == 'Local')"/>
                <field name="update_consignment" string="Update Consignment" invisible="1"/>
              </xpath>
              <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="invisible">purchase_id != False</attribute>
                <attribute name="readonly">(state in ['cancel', 'done']) or ((sales_order != False) or (state in ['done', 'cancel']))</attribute>
              </xpath>
              <xpath expr="//field[@name='origin']" position="after">
                <field name="journal_type" string="Journal Type" options="{&quot;no_create&quot;:true}" invisible="movement_journal == False" readonly="False" required="movement_journal == True" force_save="0"/>
                <field name="gl_account_status" string="G/L Account Status" force_save="True" readonly="1" invisible="movement_journal == False"/>
                <field name="offset_account_updated" string="Offset Account Updated" force_save="True" readonly="1" invisible="1"/>
                <field name="sale_id" force_save="True" readonly="1" invisible="sale_id == False"/>
                <field name="ticket_sales_order" string="Ticket Sales Order" invisible="ticket_sales_order == False"/>
                <field name="repair_payment_made" string="Repair Payment Made" force_save="True" readonly="1" invisible="1"/>
                <field name="cash_full_payment_made" string="Cash Full Payment Made" invisible="1"/>
                <field name="quotation_type" string="Quotation Type" required="False" force_save="1" readonly="True"/>
                <field name="type_of_operation" string="Type of Operation"/>
                <field name="sequence_code" string="Sequence Code" invisible="1"/>
                <field name="movement_journal" string="Movement Journal" invisible="1"/>
                <field name="mj_in" string="MJ IN" invisible="1"/>
                <field name="mj_out" string="MJ OUT" invisible="1"/>
                <field name="valid_factory_repair" string="Valid Factory Repair" force_save="True" readonly="1" invisible="1"/>
                <field name="quotation_type_2" string="Quotation Type-2" invisible="1"/>
                <field name="analytic_account" string="Analytic Account" invisible="quotation_type != 'Project'"/>
                <field name="budget_created" string="Budget Created" invisible="1"/>
                <field name="repair_return_location" string="Repair Return Location" invisible="1"/>
                <field name="return_receipt_location" string="Return Receipt Location" invisible="1"/>
                <field name="return_sequence" string="Return Sequence" invisible="1"/>
                <field name="maintenance_request_" string="Maintenance Request #" invisible="1"/>
                <field name="transfer_approval" string="Transfer Approval" force_save="True" readonly="1" invisible="1"/>
                <field name="transfer_request_sent" string="Transfer Request Sent" force_save="True" readonly="1" invisible="1"/>
                <field name="transfer_approved" string="Transfer Approved" force_save="True" readonly="1" invisible="1"/>
                <field name="transfer_rejected" string="Transfer Rejected" force_save="True" readonly="1" invisible="1"/>
                <field name="valid_transfer_lines" string="Valid Transfer Lines" force_save="True" readonly="1" invisible="1"/>
              </xpath>
              <xpath expr="//field[@name='owner_id']" position="after">
                <field name="user_location_validation" string="User Location Validation" invisible="1"/>
                <field name="user_location_validation_2" string="User Location Validation 2" force_save="True" readonly="1" invisible="1"/>
                <field name="picking_count" string="Picking Count" force_save="True" readonly="1" invisible="1"/>
                <field name="fsm_task_done" string="FSM Task Done" force_save="True" readonly="1" invisible="1"/>
                <field name="fully_paid_so" string="Fully Paid SO" invisible="1"/>
                <field name="factory_repair" string="Factory Repair" force_save="True" readonly="1" invisible="1"/>
                <field name="received_at_centre" string="Received at Centre" invisible="1" force_save="True" readonly="1"/>
                <field name="validation" string="Validation" force_save="True" readonly="1" invisible="((received_at_centre == True) and (factory_repair == True)) or (factory_repair != True)"/>
              </xpath>
              <xpath expr="//field[@name='move_ids_without_package']" position="attributes">
                <attribute name="readonly">(state == 'done' and is_locked) or (((update_consignment == True) and (pr_type == 'Import')) or ((is_locked == True) and (state == 'done')))</attribute>
              </xpath>
              <xpath expr="//field[@name='description_picking']" position="after">
                <field name="update_consignment" string="Update Consignment" column_invisible="1"/>
                <field name="pr_type" string="PR Type" column_invisible="1"/>
              </xpath>
              <xpath expr="//button[@name='action_put_in_pack']" position="attributes">
                <attribute name="groups">stock.group_tracking_lot,base.group_erp_manager</attribute>
                <attribute name="studio_approval">True</attribute>
              </xpath>
            </data>
        </field>
    </record>
