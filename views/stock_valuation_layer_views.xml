<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="aw_f4_stock_valuation_layer_stock_valuation_layer" model="ir.actions.act_window">
    <field name="name">stock.valuation.layer</field>
    <field name="res_model">stock.valuation.layer</field>
    <field name="view_mode">tree,form,pivot</field>
  </record>
  <record id="act_window_2809_stock_valuation_layer" model="ir.actions.act_window">
    <field name="name">stock.valuation.layer</field>
    <field name="res_model">stock.valuation.layer</field>
    <field name="view_mode">tree,form,pivot</field>
    <field name="context">{}</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">
                    This is your new action.
                </p>
                <p>By default, it contains a list and a form view and possibly
                    other view types depending on the options you chose for your model.
                </p>
                <p>
                    You can start customizing these screens by clicking on the Studio icon on the
                    top right corner (you can also customize this help message there).
                </p>
            </field>
  </record>
    <record id="ported_view_2585_studio_stock_valuation_layer_tree" model="ir.ui.view">
        <field name="name">Odoo Studio: stock.valuation.layer.tree customization</field>
        <field name="model">stock.valuation.layer</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="stock_account.stock_valuation_layer_tree"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//field[@name='create_date']" position="after">
                <field optional="show" name="x_studio_related_field_bPlxa" string="From"/>
                <field optional="show" name="x_studio_related_field_ygmmJ" string="To"/>
              </xpath>
              <xpath expr="//tree[1]/field[@name='product_id']" position="after">
                <field name="description" optional="show"/>
              </xpath>
              <xpath expr="//field[@name='quantity']" position="attributes">
                <attribute name="string">Total Quantity</attribute>
                <attribute name="sum">Sum of Quantity</attribute>
                <attribute name="widget">monetary</attribute>
              </xpath>
              <xpath expr="//field[@name='uom_id']" position="after">
                <field name="unit_cost"/>
              </xpath>
              <xpath expr="//field[@name='value']" position="after">
                <field name="remaining_value"/>
                <field name="account_move_id"/>
                <field name="id"/>
              </xpath>
            </data>
        </field>
    </record>
  <record id="act_window_2809_stock_valuation_layer" model="ir.actions.act_window">
    <field name="name">stock.valuation.layer</field>
    <field name="res_model">stock.valuation.layer</field>
    <field name="view_mode">tree,form,pivot</field>
  </record>
</odoo>
