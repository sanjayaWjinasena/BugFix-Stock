<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_default_form_view_fo_f9b27db6_1eab_4eda_b8d3_cb9c6a750b20" model="ir.ui.view">
    <field name="name">Default form view for x_consignment_line</field>
    <field name="model">x_consignment_line</field>
    <field name="key">studio_customization.default_form_view_fo_f9b27db6-1eab-4eda-b8d3-cb9c6a750b20</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="Consignment Line">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
          <field name="x_active" invisible="1"/>
          <div class="oe_title">
                      <h1>
                          <field name="x_name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_0644e6">
            <group name="studio_group_0644e6_left"/>
            <group name="studio_group_0644e6_right"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="ported_default_list_view_fo_6cc3eb9e_4aa0_4d62_9a65_09f4615e538a" model="ir.ui.view">
    <field name="name">Default list view for x_consignment_line</field>
    <field name="model">x_consignment_line</field>
    <field name="key">studio_customization.default_list_view_fo_6cc3eb9e-4aa0-4d62-9a65-09f4615e538a</field>
    <field name="type">tree</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree>
        <field name="x_studio_sequence" widget="handle"/>
        <field name="x_name"/>
      </tree>
    </field>
  </record>
  <record id="ported_default_search_view__f7854b6b_48b3_4304_b677_91a385b1660f" model="ir.ui.view">
    <field name="name">Default search view for x_consignment_line</field>
    <field name="model">x_consignment_line</field>
    <field name="key">studio_customization.default_search_view__f7854b6b-48b3-4304-b677-91a385b1660f</field>
    <field name="type">search</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <search>
        <field name="x_name"/>
        <separator/>
        <filter string="Archived" name="archived_x_consignment_line" domain="[['x_active', '=', False]]"/>
        <separator/>
      </search>
    </field>
  </record>
  <record id="ported_odoo_studio_default__78da7f9d_ed07_4f90_93a4_ae3e04634993" model="ir.ui.view">
    <field name="name">Odoo Studio: Default list view for x_consignment_line customization</field>
    <field name="model">x_consignment_line</field>
