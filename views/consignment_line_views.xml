              <xpath expr="//group[@name='studio_group_0644e6_right']" position="inside">
                <field name="currency_id"/>
                <field name="invoice_qty" string="Invoice Qty."/>
                <field name="unit_price" string="Unit Price"/>
                <field name="amount" string="Amount"/>
                <field name="received_qty" string="Received Qty."/>
                <field name="status" string="Status"/>
              </xpath>
            </data>
        </field>
    </record>
