  <record id="view_tariffmaster_form" model="ir.ui.view">
    <field name="name">Default form view for tariffmaster</field>
    <field name="model">tariffmaster</field>
    <field name="priority">16</field>
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="TariffMaster">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
          <field name="active" invisible="1"/>
          <div class="oe_title">
                      <h1>
                          <field name="name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_f8209d">
            <group name="studio_group_f8209d_left"/>
            <group name="studio_group_f8209d_right"/>
          </group>
        </sheet>
        <div class="oe_chatter" name="oe_chatter">
          <field name="message_follower_ids"/>
          <field name="message_ids"/>
          <field name="activity_ids"/>
        </div>
      </form>
    </field>
  </record>
  <record id="view_default_form_view_for_tariffmaster_inherit" model="ir.ui.view">
    <field name="name">Odoo Studio: Default form view for tariffmaster customization</field>
    <field name="model">tariffmaster</field>
    <field name="inherit_id" ref="BugFix-Stock.view_tariffmaster_form"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//form[1]/sheet[1]/div[1]/h1[1]/field[@name='name']" position="attributes">
          <attribute name="string">Tarrif Code</attribute>
        </xpath>
        <xpath expr="//group[@name='studio_group_f8209d_left']" position="inside">
          <field name="description" string="Description"/>
          <field name="accounting_company_id" string="Company"/>
        </xpath>
        <xpath expr="//group[@name='studio_group_f8209d']" position="after">
          <notebook name="studio_notebook_T0Dw9">
            <page string="Date Range" name="studio_page_T0Dw9">
              <!-- DROPPED (orphan tariff_master_ids not on tariffmaster) --></page>
          </notebook>
        </xpath>
      </data>
    </field>
  </record>
  <record id="view_tariffmaster_list" model="ir.ui.view">
    <field name="name">Default list view for tariffmaster</field>
    <field name="model">tariffmaster</field>
    <field name="priority">16</field>
    <field name="arch" type="xml">
      <tree>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
      </tree>
    </field>
  </record>
  <record id="view_default_list_view_for_tariffmaster_inherit" model="ir.ui.view">
    <field name="name">Odoo Studio: Default list view for tariffmaster customization</field>
    <field name="model">tariffmaster</field>
    <field name="inherit_id" ref="BugFix-Stock.view_tariffmaster_list"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//field[@name='sequence']" position="before">
          <xpath expr="//field[@name='name']" position="move"/>
          <field name="description"/>
          <field name="accounting_company_id" optional="show"/>
        </xpath>
        <xpath expr="//field[@name='sequence']" position="attributes">
          <attribute name="column_invisible">1</attribute></xpath>
        <xpath expr="//field[@name='name']" position="attributes">
          <attribute name="required">1</attribute></xpath>
      </data>
    </field>
  </record>
    <record id="view_tariffmaster_search" model="ir.ui.view">
      <field name="name">Default search view for tariffmaster</field>
      <field name="model">tariffmaster</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="name"/>
  <separator/>
  <filter string="Archived" name="archived_tariffmaster" domain="[['active', '=', False]]"/>
  <separator/>
</search>
      </field>
    </record>
</odoo>
