       views/upstream_link_fields_views.xml. -->
  <record id="ported_view_6071_odoo_studio_stock_rule_tree_customizatio" model="ir.ui.view">
    <field name="name">Odoo Studio: stock.rule.tree customization</field>
    <field name="model">stock.rule</field>
    <field name="inherit_id" ref="stock.view_stock_rule_tree"/>
