          <!-- STRIPPED field x_studio_supplier_invoice_no not on x_temp_con_consolidate -->
          <!-- STRIPPED field x_studio_container_no not on x_temp_con_consolidate -->
          <!-- STRIPPED field x_studio_custom_clearance_no not on x_temp_con_consolidate -->
          <!-- STRIPPED field x_studio_delivery_term not on x_temp_con_consolidate -->
          <!-- STRIPPED field x_studio_shipment_start_date not on x_temp_con_consolidate -->
          <!-- STRIPPED field x_studio_invoice_date not on x_temp_con_consolidate -->
          <!-- STRIPPED field x_studio_shipping_mode not on x_temp_con_consolidate -->	
          <!-- STRIPPED field x_studio_status not on x_temp_con_consolidate -->
        </tree>
      </field>
    </group>
    <newline/>
    <footer>
      <button name="1420" string="Apply" type="action" class="oe_highlight"/>
      <button special="cancel" string="Cancel" class="oe_link"/>
    </footer>
</form>
      </field>
    </record>

  </data>
</odoo>