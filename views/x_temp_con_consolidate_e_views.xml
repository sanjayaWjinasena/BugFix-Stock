    <group>
      <field name="x_name" options="{'no_open': true}" invisible="1" readonly="True"/>
      <field name="x_studio_consolidated_header_id" options="{'no_open': true}" invisible="1" readonly="True"/>
      <field name="x_studio_select_all" options="{'no_open': true}" invisible="1" readonly="True"/>
    </group> 
    <newline/>
    <button name="1417" string="Select All" type="action" class="oe_highlight" invisible="x_studio_select_all == True"/> 
    <button name="1419" string="Clear All" type="action" class="oe_highlight" invisible="x_studio_select_all == False"/>
    <group>
      <field name="x_studio_con_lines" nolabel="1" colspan="2">
        <tree string="Details" create="false" editable="bottom" delete="false"> 
          <!-- STRIPPED field x_studio_select not on x_temp_con_consolidate -->
          <!-- STRIPPED field x_studio_consignment_id not on x_temp_con_consolidate -->
          <!-- STRIPPED field x_studio_supplier_id not on x_temp_con_consolidate -->
