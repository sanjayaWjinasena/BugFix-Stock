<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="act_window_3384_material_request_mt" model="ir.actions.act_window">
    <field name="name">Material Request MT</field>
    <field name="res_model">material_request_mt</field>
    <field name="view_mode">kanban,tree,form,calendar,gantt,map,pivot,graph</field>
    <field name="context">{}</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">
                    This is your new action.
                </p>
                <p>By default, it contains a list and a form view and possibly
                    other view types depending on the options you chose for your model.
                </p>
                <p>
                    You can start customizing these screens by clicking on the Studio icon on the
                    top right corner (you can also customize this help message there).
                </p>
            </field>
  </record>
    <record id="view_8765_default_calendar_view_for_x_material_request_mt_e" model="ir.ui.view">
      <field name="name">Default calendar view for material_request_mt</field>
      <field name="model">material_request_mt</field>
      <field name="type">calendar</field>
      <field name="arch" type="xml">
        <calendar date_start="date" create_name_field="name"/>
      </field>
    </record>
    <record id="view_8763_default_form_view_for_x_material_request_mt_e" model="ir.ui.view">
      <field name="name">Default form view for material_request_mt</field>
      <field name="model">material_request_mt</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
  <header>
    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
  </header>
  <sheet string="Material Request MT">
    <field name="kanban_state" widget="state_selection"/>
    <widget name="web_ribbon" text="Archived" bg_color="text-bg-danger" invisible="active"/>
    <field name="active" invisible="1"/>
    <field class="oe_avatar" widget="image" name="image"/>
    <div class="oe_title">
                <h1>
                    <field name="name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_a56f01">
      <group name="studio_group_a56f01_left">
        <field name="partner_id"/>
        <field name="partner_phone" widget="phone" options="{'enable_sms': True}"/>
        <field name="partner_email" widget="email"/>
        <field name="date"/>
        <field name="date_start" string="Dates" widget="daterange" options="{'end_date_field': 'date_stop'}"/>
        <field name="date_stop" invisible="1"/>
      </group>
      <group name="studio_group_a56f01_right">
        <field name="user_id" widget="many2one_avatar_user"/>
        <field name="accounting_currency_id" invisible="1"/>
        <field name="value"/>
        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
        <field name="accounting_company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
      </group>
    </group>
    <group>
      <field name="notes" placeholder="Type down your notes here..." nolabel="1" colspan="2"/>
    </group>
    <notebook>
      <page string="Details" name="lines">
        <!-- STRIPPED field material_request_mt_line_ids_7737e not on material_request_mt -->
      </page>
    </notebook>
  </sheet>
  <div class="oe_chatter" name="oe_chatter">
    <field name="message_follower_ids"/>
    <field name="message_ids"/>
    <field name="activity_ids"/>
  </div>
</form>
      </field>
    </record>
    <record id="view_8766_default_gantt_view_for_x_material_request_mt_e" model="ir.ui.view">
      <field name="name">Default gantt view for material_request_mt</field>
      <field name="model">material_request_mt</field>
      <field name="type">gantt</field>
      <field name="arch" type="xml">
        <gantt date_start="date_start" date_stop="date_stop"/>
      </field>
    </record>
    <record id="view_8770_default_graph_view_for_x_material_request_mt_e" model="ir.ui.view">
      <field name="name">Default graph view for material_request_mt</field>
      <field name="model">material_request_mt</field>
      <field name="type">graph</field>
      <field name="arch" type="xml">
        <graph sample="1">
  <field name="value" type="measure"/>
  <field name="create_date" type="row"/>
</graph>
      </field>
    </record>
    <record id="view_8767_default_kanban_view_for_x_material_request_mt_e" model="ir.ui.view">
      <field name="name">Default kanban view for material_request_mt</field>
      <field name="model">material_request_mt</field>
      <field name="type">kanban</field>
      <field name="arch" type="xml">
        <kanban default_group_by="stage_id" default_order="custom_reports_priority desc, sequence asc, id desc">
  <field name="color"/>
  <field name="user_id" widget="many2one_avatar_user"/>
  <field name="accounting_currency_id"/>
  <progressbar field="kanban_state" colors="{&quot;normal&quot;: &quot;200&quot;, &quot;done&quot;: &quot;success&quot;, &quot;blocked&quot;: &quot;danger&quot;}" sum_field="value"/>
  <templates>
    <t t-name="kanban-box">
      <div t-attf-class="#{!selection_mode ? kanban_color(record.color.raw_value) : ''} oe_kanban_global_click">
        <field class="o_kanban_image" name="image" widget="image" options="{&quot;zoom&quot;: true, &quot;background&quot;: true, &quot;preventClicks&quot;: false}"/>
        <div class="o_kanban_record_details">
          <div class="o_kanban_record_top" name="studio_auto_kanban_top">
            <div class="o_kanban_record_headings" name="studio_auto_kanban_headings">
              <field name="custom_reports_priority" widget="boolean_favorite" nolabel="1"/>
              <strong class="o_kanban_record_title" name="studio_auto_kanban_title">
                <field name="name"/>
              </strong>
            </div>
            <div class="o_dropdown_kanban dropdown">
              <a role="button" class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" data-display="static" href="#" aria-label="Dropdown Menu" title="Dropdown Menu">
                <span class="fa fa-ellipsis-v"/>
              </a>
              <div class="dropdown-menu" role="menu">
                <a t-if="widget.editable" role="menuitem" type="edit" class="dropdown-item">Edit</a>
                <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                <ul class="oe_kanban_colorpicker" data-field="color"/>
              </div>
            </div>
          </div>
          <div class="o_kanban_record_body" name="studio_auto_kanban_body">
            <field name="tag_ids" options="{'color_field': 'color'}"/>
          </div>
          <div class="o_kanban_record_bottom" name="studio_auto_kanban_bottom">
            <div class="oe_kanban_bottom_left" name="studio_auto_kanban_bottom_left">
              <field name="value"/>
            </div>
            <div class="oe_kanban_bottom_right" name="studio_auto_kanban_bottom_right">
              <field name="kanban_state" widget="state_selection"/>
              <t t-set="unassigned" t-translation="on">Unassigned</t>
              <img t-att-src="kanban_image('res.users', 'avatar_128', record.user_id.raw_value)" t-att-title="record.user_id.value || unassigned" t-att-alt="record.user_id.value" class="oe_kanban_avatar o_image_24_cover float-right"/>
            </div>
          </div>
        </div>
      </div>
    </t>
  </templates>
</kanban>
      </field>
    </record>
    <record id="view_8762_default_list_view_for_x_material_request_mt_e" model="ir.ui.view">
      <field name="name">Default list view for material_request_mt</field>
      <field name="model">material_request_mt</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree>
  <field name="name"/>
  <field name="partner_id"/>
  <field name="user_id" widget="many2one_avatar_user"/>
  <field name="accounting_company_id" groups="base.group_multi_company"/>
  <field name="accounting_currency_id" invisible="1"/>
  <field name="value" sum="Total"/>
  <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
  <field name="color" widget="color_picker"/>
</tree>
      </field>
    </record>
    <record id="view_8768_default_map_view_for_x_material_request_mt_e" model="ir.ui.view">
      <field name="name">Default map view for material_request_mt</field>
      <field name="model">material_request_mt</field>
      <field name="type">map</field>
      <field name="arch" type="xml">
        <map res_partner="partner_id">
  <field name="partner_id" string="Partner"/>
</map>
      </field>
    </record>
    <record id="view_8769_default_pivot_view_for_x_material_request_mt_e" model="ir.ui.view">
      <field name="name">Default pivot view for material_request_mt</field>
      <field name="model">material_request_mt</field>
      <field name="type">pivot</field>
      <field name="arch" type="xml">
        <pivot sample="1">
  <field name="value" type="measure"/>
  <field name="stage_id" type="col"/>
  <field name="date" type="row"/>
</pivot>
      </field>
    </record>
    <record id="view_8764_default_search_view_for_x_material_request_mt_e" model="ir.ui.view">
      <field name="name">Default search view for material_request_mt</field>
      <field name="model">material_request_mt</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="date" invisible="1"/><field name="date_start" invisible="1"/><field name="date_stop" invisible="1"/><field name="stage_id" invisible="1"/><field name="name"/>
  <field name="partner_id" operator="child_of"/>
  <field name="user_id"/>
  <field name="tag_ids"/>
  <filter string="My Material Request MT" name="my_material_request_mt" domain="[['user_id', '=', uid]]"/>
  <separator/>
  <filter date="date" name="studio_filter_date" string="Date"/>
  <filter date="date_start" name="studio_filter_date_start" string="Start Date"/>
  <filter date="date_stop" name="studio_filter_date_stop" string="End Date"/>
  <separator/>
  <filter string="Archived" name="archived_material_request_mt" domain="[['active', '=', False]]"/>
  <separator/>
  <filter name="groupby_x_partner" string="Partner" context="{'group_by': 'partner_id'}" domain="[]"/>
  <filter name="groupby_x_user" string="Responsible" context="{'group_by': 'user_id'}" domain="[]"/>
  <filter name="stage_id" string="Stage" context="{'group_by': 'stage_id'}" domain="[]"/>
</search>
      </field>
    </record>
    <record id="view_final_x_material_request_mt_odoo_studio_default_form_view_for_x_material_request_mt_c" model="ir.ui.view">
      <field name="name">Odoo Studio: Default form view for material_request_mt customization</field>
      <field name="model">material_request_mt</field>
      <field name="type">form</field>
      <field name="priority">99</field>
      <field name="inherit_id" ref="BugFix-Stock.view_8763_default_form_view_for_x_material_request_mt_e"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//form[1]/sheet[1]/notebook[1]" position="replace"/>
  <xpath expr="//form[1]/sheet[1]/group[not(@name)][1]" position="replace"/>
  <xpath expr="//group[@name='studio_group_a56f01_right']" position="replace"/>
  <xpath expr="//field[@name='date_start']" position="replace">
    <field name="many2one_field_32i_1j8i1f37m" options="{'create_name_field': 'complete_name'}" string="Department"/>
  </xpath>
  <xpath expr="//field[@name='date']" position="replace"/>
  <xpath expr="//field[@name='partner_email']" position="replace"/>
  <xpath expr="//field[@name='partner_phone']" position="replace"/>
  <xpath expr="//field[@name='partner_id']" position="replace"/>
  <xpath expr="//field[@name='name']" position="attributes">
    <attribute name="force_save">1</attribute>
    <attribute name="readonly">True</attribute>
    <attribute name="required">False</attribute>
    <attribute name="string">Description</attribute>
  </xpath>
</data>
      </field>
    </record>
    <record id="view_final_x_material_request_mt_odoo_studio_default_kanban_view_for_material_request_mt" model="ir.ui.view">
      <field name="name">Odoo Studio: Default kanban view for material_request_mt customization</field>
      <field name="model">material_request_mt</field>
      <field name="type">kanban</field>
      <field name="priority">99</field>
      <field name="inherit_id" ref="BugFix-Stock.view_8767_default_kanban_view_for_x_material_request_mt_e"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//field[@name='name']" position="attributes">
    <attribute name="string">Description</attribute>
  </xpath>
</data>
      </field>
    </record>
    <record id="view_final_x_material_request_mt_odoo_studio_default_list_view_for_x_material_request_mt_c" model="ir.ui.view">
      <field name="name">Odoo Studio: Default list view for material_request_mt customization</field>
      <field name="model">material_request_mt</field>
      <field name="type">tree</field>
      <field name="priority">99</field>
      <field name="inherit_id" ref="BugFix-Stock.view_8762_default_list_view_for_x_material_request_mt_e"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//field[@name='color']" position="replace"/>
  <xpath expr="//field[@name='tag_ids']" position="replace"/>
  <xpath expr="//field[@name='value']" position="replace"/>
  <xpath expr="//field[@name='accounting_currency_id']" position="replace"/>
  <xpath expr="//field[@name='accounting_company_id']" position="replace"/>
  <xpath expr="//field[@name='user_id']" position="replace"/>
  <xpath expr="//field[@name='partner_id']" position="replace"/>
  <xpath expr="//field[@name='name']" position="before">
    <field name="many2one_field_32i_1j8i1f37m" optional="show"/>
  </xpath>
</data>
      </field>
    </record>
</odoo>
