<?xml version="1.0" encoding="utf-8"?>
<!--
    BugFix-Stock v0.0.23: view 4732 (stock.picking.form_button, priority
    999905, 6.8 KB).

    Continuation of v0.0.22 (which shipped view 2387 alone after this
    same 4732 crashed the first attempt).

    Surgery: 1 xpath element removed via etree - the block
        `<xpath expr="//header/button[@name='action_set_quantities_to_reservation']" position="attributes">`
    That button doesn't exist on repair-test-101 stock.view_picking_form
    (Odoo minor-version drift). The xpath only tweaked the button's
    `invisible` condition - stripping it leaves the condition at Odoo
    default. Zero functional loss.

    Other 9 xpath expressions preserved. All 8 numeric name= refs
    interpolated to %(xmlid)d.

    Adds Request/Approve/Reject Transfer + Update Offset Account +
    Validate Reject Reason buttons to stock.picking form.
-->
<odoo>

    <record id="ported_view_4732_studio_stock_picking_form_button" model="ir.ui.view">
        <field name="name">Odoo Studio: stock.picking.form_button</field>
        <field name="model">stock.picking</field>
        <field name="type">form</field>
        <field name="priority">999905</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <data>
    
                <xpath expr="//header/button[@name='%(stock.act_stock_return_picking)d']" position="attributes">
                  <attribute name="invisible">((x_studio_task_status == False) and (x_studio_helpdesk_ticket_id != False)) or ((state != 'done') or (x_studio_helpdesk_ticket_id != False))</attribute></xpath>
    
                <xpath expr="//header/button[@name='action_assign']" position="after">
                  <button type="action" name="%(BugFix-Stock.server_action_1367_imp_update_consignment_final)d" string="Update Consignment" class="btn-primary" invisible="(state == 'cancel') or (((x_studio_update_consignment == True) and (x_studio_pr_type == 'Import')) or ((x_studio_pr_type == False) or (x_studio_pr_type == 'Local')))"/>
                </xpath>
    
                <xpath expr="//header/button[@name='%(stock.act_stock_return_picking)d']" position="before">
                  <button type="action" name="%(stock.act_stock_return_picking)d" string="Dispatch" invisible="((x_studio_received_at_centre == False) and ((x_studio_factory_repair == True) and (x_studio_created_from_help_ticket != False))) or (((x_studio_received_at_centre == False) and ((x_studio_factory_repair == True) and (x_studio_helpdesk_ticket_id != False))) or (((x_studio_valid_factory_repair == False) and ((x_studio_factory_repair == True) and (x_studio_created_from_help_ticket != False))) or (((x_studio_valid_factory_repair == False) and ((x_studio_factory_repair == True) and (x_studio_helpdesk_ticket_id != False))) or (((x_studio_fsm_task_done == False) and (x_studio_created_from_help_ticket != False)) or (((x_studio_fsm_task_done == False) and (x_studio_helpdesk_ticket_id != False)) or (((x_studio_cancelled == False) and ((x_studio_task_status == False) and (x_studio_helpdesk_ticket_id != False))) or ((state != 'done') or ((x_studio_helpdesk_ticket_id == False) or ((x_studio_cash_full_payment_made == True) or ((x_studio_fully_paid_so == False) or (x_studio_picking_count == True)))))))))))"/>
                </xpath>
    
                <xpath expr="//header/button[@name='%(stock.act_stock_return_picking)d'][2]" position="before">
                  <button type="action" name="%(BugFix-Stock.server_action_1999_rr_re_return_validation)d" string="Retun Reject Reason" class="btn-primary" invisible="((x_studio_fsm_task_done == True) and (x_studio_created_from_help_ticket != False)) or (((x_studio_fsm_task_done == True) and (x_studio_helpdesk_ticket_id != False)) or ((state != 'done') or ((x_studio_helpdesk_ticket_id == False) or (x_studio_cancelled == True))))"/>
                </xpath>
    
                <!--xpath expr="//header/button[@name='button_validate']" position="before">
                  <button type="action" name="%(BugFix-Stock.server_action_2204_rr_request_transfer_approval)d" string="Request Transfer Approval" class="btn-primary" attrs="{'invisible': ['|','|','|','|','|',('x_studio_need_approval', '=', False),('x_studio_cancelled', '=', True),('x_studio_valid_transfer_lines', '=', False),('x_studio_transfer_approved', '=', True),('x_studio_transfer_rejected', '=', True),('x_studio_transfer_request_sent', '=', True)]}"></button>
                </xpath>
    
                <xpath expr="//header/button[@name='%(BugFix-Stock.server_action_2204_rr_request_transfer_approval)d']" position="after">
                  <button type="action" name="%(BugFix-Stock.server_action_2205_rr_transfer_approval)d" string="Approve Transfer" class="btn-primary" attrs="{'invisible': ['|','|','|',('x_studio_cancelled', '=', True),('x_studio_transfer_approved', '=', True),('x_studio_transfer_rejected', '=', True),('x_studio_transfer_request_sent', '=', False)]}"></button>
                </xpath>
    
                <xpath expr="//header/button[@name='%(BugFix-Stock.server_action_2205_rr_transfer_approval)d']" position="after">
                  <button type="action" name="%(BugFix-Stock.server_action_2207_rr_transfer_rejection)d" string="Reject Transfer" class="btn-primary" attrs="{'invisible': ['|','|','|',('x_studio_cancelled', '=', True),('x_studio_transfer_approved', '=', True),('x_studio_transfer_rejected', '=', True),('x_studio_transfer_request_sent', '=', False)]}"></button>
                </xpath-->
    
                <!--xpath expr="//header/button[@name='%(BugFix-Stock.server_action_2207_rr_transfer_rejection)d']" position="after"-->
                <xpath expr="//header/button[@name='button_validate']" position="after">
                  <button type="action" name="%(BugFix-Stock.server_action_2448_movement_journals_update_offset_account)d" string="Update Offset Account" class="btn-primary" invisible="(x_studio_offset_account_updated == True) or ((state != 'done') or (x_studio_movement_journal == False))"/>
                </xpath>
    
                <xpath expr="//header/button[@name='%(BugFix-Stock.server_action_2448_movement_journals_update_offset_account)d']" position="after">
                  <button type="action" name="%(BugFix-Stock.server_action_2181_proj_show_validate_block_errors)d" string="Validate Reject Reason" class="btn-primary" invisible="(x_studio_budget_created == True) or ((x_studio_quotation_type_2 != 'Project') or (x_studio_cancelled == True))"/>
                </xpath>
    
                <xpath expr="//header/button[@name='button_validate']" position="attributes">
                  <!--attribute name="attrs">{'invisible': ['|','|','|','|','|','|','|','|',('x_studio_cancelled', '=', True),('x_studio_valid_transfer_lines', '=', False),('x_studio_transfer_rejected', '=', True),('state', 'in', ('waiting','confirmed')), ('show_validate', '=', False),'&amp;',('x_studio_quotation_type_2', '=', 'Repair'),('x_studio_repair_payment_made', '=', False),'&amp;',('x_studio_pr_type', '=', 'Import'),('x_studio_update_consignment', '=', False),'&amp;',('x_studio_quotation_type_2', '=', 'Project'),('x_studio_budget_created', '=', False),'&amp;',('x_studio_need_approval', '=', True),('x_studio_transfer_approved', '=', False)]}</attribute-->
                  <attribute name="invisible">((x_studio_budget_created == False) and (x_studio_quotation_type_2 == 'Project')) or (((x_studio_update_consignment == False) and (x_studio_pr_type == 'Import')) or (((x_studio_repair_payment_made == False) and (x_studio_quotation_type_2 == 'Repair')) or ((show_validate == False) or ((state in ('waiting', 'confirmed')) or ((x_studio_transfer_rejected == True) or ((x_studio_valid_transfer_lines == False) or (x_studio_cancelled == True)))))))</attribute></xpath>
    
                <!--xpath expr="//header/button[@name='action_set_quantities_to_reservation']" position="attributes">
                  <attribute name="attrs">{'invisible': ['|','|','|',('x_studio_helpdesk_ticket_id','!=',False),('show_validate', '=', False),('immediate_transfer', '=', True),'&amp;',('x_studio_pr_type', '=', 'Import'),('x_studio_update_consignment', '=', False)]}</attribute> 
                </xpath-->
    
                <xpath expr="//sheet/notebook/page/field[@name='move_ids_without_package']" position="attributes">
                  <attribute name="readonly">((x_studio_update_consignment == True) and (x_studio_pr_type == 'Import')) or ((is_locked == True) and (state == 'done'))</attribute></xpath>
    
                <xpath expr="//header/button[@name='action_confirm']" position="attributes">
                  <!--attribute name="attrs">{'invisible': ['|',('show_mark_as_todo', '=', False),'&amp;',('x_studio_need_approval', '=', True),('x_studio_transfer_approved', '=', False)]}</attribute--> 
                  <attribute name="invisible">show_mark_as_todo == False</attribute></xpath>
              </data>
        </field>
    </record>

</odoo>
