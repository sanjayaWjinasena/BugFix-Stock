<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_con_consolidated_header" model="ir.actions.act_window">
    <field name="name">Con. Consolidated Header</field>
    <field name="res_model">con_consolidated_hea</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="action_consolidated_consignments" model="ir.actions.act_window">
    <field name="name">Consolidated Consignments</field>
    <field name="res_model">con_consolidated_hea</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="action_consolidated_consignments_2" model="ir.actions.act_window">
    <field name="name">Consolidated Consignments</field>
    <field name="res_model">con_consolidated_hea</field>
    <field name="view_mode">tree,form</field>
  </record>
  <record id="view_con_consolidated_hea_form" model="ir.ui.view">
    <field name="name">Default form view for con_consolidated_hea</field>
    <field name="model">con_consolidated_hea</field>
    <field name="priority">16</field>
    <field name="arch" type="xml">
      <form>
        <header>  
          <button type="action" name="%(BugFix-Stock.action_imp_copy_consignment_lines_to_consolidation)d" string="Copy PI Header" class="btn-primary" invisible="status not in ['Draft']"/>
          <button type="action" name="%(BugFix-Stock.action_imp_clear_consignment_lines_from_consolidation)d" string="Clear PI Header" class="btn-primary" invisible="(status not in ['Draft']) or (lines_copied == False)"/>
          <button type="action" name="%(BugFix-Stock.action_imp_confirm_consolidation)d" string="Confirm" class="btn-primary" invisible="(status not in ['Draft']) or (lines_copied == False)"/>
        </header>
        <header/>
        <sheet string="Con. Consolidated Header">
          <field name="status" invisible="1"/><field name="lines_copied" invisible="1"/><widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
          <field name="active" invisible="1"/>
          <div class="oe_title">
                      <span class="o_form_label">Con. Reference </span>
                      <h1>
                          <field name="name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_bc4ef6">
            <group name="studio_group_bc4ef6_left"/>
            <group name="studio_group_bc4ef6_right"/>
          </group>
        </sheet>
        <div class="oe_chatter" name="oe_chatter">
          <field name="message_follower_ids"/>
          <field name="message_ids"/>
          <field name="activity_ids"/>
        </div>
      </form>
    </field>
  </record>
  <record id="view_default_form_view_for_con_consolidated_hea_inherit" model="ir.ui.view">
    <field name="name">Odoo Studio: Default form view for con_consolidated_hea customization</field>
    <field name="model">con_consolidated_hea</field>
    <field name="inherit_id" ref="BugFix-Stock.view_con_consolidated_hea_form"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//button[@name='%(BugFix-Stock.action_imp_clear_consignment_lines_from_consolidation)d']" position="after">
          <field widget="statusbar" name="pipeline_status_bar" string="Pipeline Status Bar"/>
        </xpath>
        <xpath expr="//form[1]/sheet[1]/div[1]/h1[1]/field[@name='name']" position="attributes">
          <attribute name="force_save">True</attribute>
          <attribute name="readonly">1</attribute></xpath>
        <xpath expr="//group[@name='studio_group_bc4ef6_left']" position="inside">
          <field name="description" string="Description" readonly="status == 'Confirmed'"/>
        </xpath>
        <xpath expr="//group[@name='studio_group_bc4ef6_right']" position="inside">
          <field name="create_uid"/>
          <field name="create_date"/>
          <field name="status" string="Status" force_save="True" readonly="1"/>
          <field name="accounting_company_id" string="Company" force_save="True" readonly="1" invisible="1"/>
          <field name="lines_copied" string="Lines Copied" force_save="True" readonly="1" invisible="1"/>
        </xpath>
        <xpath expr="//group[@name='studio_group_bc4ef6']" position="after">
          <notebook name="studio_notebook_8O2sf">
            <page string="Lines" name="studio_page_8O2sf">
              <field name="con_line_ids" string="Con. Line Ids" readonly="status != 'Draft'">
                <tree create="false" edit="false">
                  <field name="sequence" widget="handle" column_invisible="1"/>
                  <field name="consignment_id" string="Consignment No" force_save="True" readonly="1"/>
                  <field name="supplier_id" force_save="True" readonly="1"/>
                  <field name="accounting_currency_id" force_save="True" readonly="1"/>
                  <field name="supplier_invoice_no" force_save="True" readonly="1"/>
                  <field name="container_no" force_save="True" readonly="1"/>
                  <field name="custom_clearance_no" force_save="True" readonly="1"/>
                  <field name="shipment_start_date" force_save="True" readonly="1" optional="hide"/>
                  <field name="accounting_invoice_date" force_save="True" readonly="1" optional="hide"/>
                  <field name="status" force_save="True" readonly="1" optional="hide"/>
                  <field name="shipping_mode_1" force_save="True" readonly="1" optional="hide"/>
                  <field name="name" column_invisible="1"/>
                </tree>
              </field>
            </page>
          </notebook>
        </xpath>
      </data>
    </field>
  </record>
  <record id="view_con_consolidated_hea_list" model="ir.ui.view">
    <field name="name">Default list view for con_consolidated_hea</field>
    <field name="model">con_consolidated_hea</field>
    <field name="priority">16</field>
    <field name="arch" type="xml">
      <tree>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
      </tree>
    </field>
  </record>
  <record id="view_default_list_view_for_con_consolidated_hea_inherit" model="ir.ui.view">
    <field name="name">Odoo Studio: Default list view for con_consolidated_hea customization</field>
    <field name="model">con_consolidated_hea</field>
    <field name="inherit_id" ref="BugFix-Stock.view_con_consolidated_hea_list"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//tree[1]" position="attributes">
          <attribute name="default_order">name desc</attribute>
        </xpath>
        <xpath expr="//field[@name='sequence']" position="before">
          <xpath expr="//field[@name='name']" position="move"/>
          <field name="description"/>
          <field name="create_uid" widget="many2one_avatar"/>
          <field name="create_date"/>
          <field name="status" widget="badge" decoration-muted="status == 'Draft'" decoration-success="status == 'Confirmed'"/>
        </xpath>
        <xpath expr="//field[@name='sequence']" position="attributes">
          <attribute name="column_invisible">1</attribute></xpath>
        <xpath expr="//field[@name='name']" position="attributes">
          <attribute name="string">Con. Reference</attribute>
        </xpath>
      </data>
    </field>
  </record>
    <record id="view_con_consolidated_hea_search" model="ir.ui.view">
      <field name="name">Default search view for con_consolidated_hea</field>
      <field name="model">con_consolidated_hea</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="name"/>
  <separator/>
  <filter string="Archived" name="archived_con_consolidated_hea" domain="[['active', '=', False]]"/>
  <separator/>
</search>
      </field>
    </record>
</odoo>
