<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_default_form_view_fo_7c80a452_820d_4f3c_a52a_11d79869f9bb" model="ir.ui.view">
    <field name="name">Default form view for x_con_consolidated_lin</field>
    <field name="model">x_con_consolidated_lin</field>
    <field name="key">studio_customization.default_form_view_fo_7c80a452-820d-4f3c-a52a-11d79869f9bb</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="Con. Consolidated Line">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
          <field name="x_active" invisible="1"/>
          <div class="oe_title">
                      <h1>
                          <field name="x_name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_759e62">
            <group name="studio_group_759e62_left"/>
            <group name="studio_group_759e62_right"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="ported_default_list_view_fo_a04e818a_84c4_4a78_9d02_6e0901e49ffd" model="ir.ui.view">
    <field name="name">Default list view for x_con_consolidated_lin</field>
    <field name="model">x_con_consolidated_lin</field>
    <field name="key">studio_customization.default_list_view_fo_a04e818a-84c4-4a78-9d02-6e0901e49ffd</field>
    <field name="type">tree</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree>
        <field name="x_studio_sequence" widget="handle"/>
        <field name="x_name"/>
      </tree>
    </field>
  </record>
  <record id="ported_default_search_view__21ebb591_905d_4b8f_b65f_3f73a3bc9f21" model="ir.ui.view">
    <field name="name">Default search view for x_con_consolidated_lin</field>
    <field name="model">x_con_consolidated_lin</field>
    <field name="key">studio_customization.default_search_view__21ebb591-905d-4b8f-b65f-3f73a3bc9f21</field>
    <field name="type">search</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <search>
        <field name="x_name"/>
        <separator/>
        <filter string="Archived" name="archived_x_con_consolidated_lin" domain="[['x_active', '=', False]]"/>
        <separator/>
      </search>
    </field>
  </record>
</odoo>
