<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="act_window_1203_ttt_structure_master" model="ir.actions.act_window">
    <field name="name">ttt structure master</field>
    <field name="res_model">x_temp_structure_maste</field>
    <field name="view_mode">form</field>
    <field name="context">{}</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">
                    This is your new action.
                </p>
                <p>By default, it contains a list and a form view and possibly
                    other view types depending on the options you chose for your model.
                </p>
                <p>
                    You can start customizing these screens by clicking on the Studio icon on the
                    top right corner (you can also customize this help message there).
                </p>
            </field>
  </record>
    <record id="view_2705_imp_apply_formula_e" model="ir.ui.view">
      <field name="name">IMP Apply Formula</field>
      <field name="model">x_temp_structure_maste</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form string="Apply Structure Formula">
  <separator string="Applicable Indicators:"/>
    <newline/>
    <group>
      <field name="x_name" options="{'no_open': true}" invisible="1" readonly="True"/>
      <!-- v118: x_studio_temp_structure_details_id moved to BugFix-Purchase (upstream_link_fields_views.xml) -->
    </group> 
    <newline/>
    <group>
      <field name="x_studio_temp_structure_details" nolabel="1" colspan="2">
        <tree string="Details" create="false" editable="bottom" delete="false"> 
          <!-- STRIPPED field x_studio_charge_name not on x_temp_structure_maste -->
          <!-- STRIPPED field x_studio_charge_group not on x_temp_structure_maste -->
        </tree>
      </field>
    </group>
    <newline/>
    <footer>
      <button name="%(BugFix-Stock.server_action_1204_imp_apply_formula)d" string="Apply" type="action" class="oe_highlight"/>
      <button special="cancel" string="Cancel" class="oe_link"/>
    </footer>
</form>
      </field>
    </record>
</odoo>
