  <record id="view_ported_primary_form_temp_consignment_hea" model="ir.ui.view">
    <field name="name">IMP Copy PO Line to Consignment</field>
    <field name="model">temp_consignment_hea</field>
    <field name="priority">16</field>
    <field name="arch" type="xml">
      <form string="Copy Import Order Lines">
        <separator string="Applicable Line:"/>
          <newline/>
          <group>
            <field name="name" options="{'no_open': true}" invisible="1" readonly="True"/>
            <field name="temp_consignment_header_id" options="{'no_open': true}" invisible="1" readonly="True"/>
            <field name="select_all" options="{'no_open': true}" invisible="1" readonly="True"/>
          </group> 
          <newline/>
          <button name="%(BugFix-Stock.action_imp_select_all_in_copy_po_lines)d" string="Select All" type="action" class="oe_highlight" invisible="select_all == True"/> 
          <button name="%(BugFix-Stock.action_imp_clear_all_in_copy_po_lines)d" string="Clear All" type="action" class="oe_highlight" invisible="select_all == False"/>
          <group>
            <field name="temp_consignment_line_ids" nolabel="1" colspan="2">
              <tree string="Details" create="false" editable="bottom" delete="false"> 
                <field name="accounting_select"/>
                <field name="accounting_purchase_id" options="{'no_open': true}" force_save="1" readonly="True"/>
                <field name="supplier_id" options="{'no_open': true}" force_save="1" readonly="True"/>
                <field name="indent_no" options="{'no_open': true}" force_save="1" readonly="True"/>
                <field name="product_id" options="{'no_open': true}" force_save="1" readonly="True"/>
                <field name="description" options="{'no_open': true}" force_save="1" readonly="True"/>
                <field name="uom_id" options="{'no_open': true}" force_save="1" readonly="True"/>
                <field name="quantity" options="{'no_open': true}" force_save="1" readonly="True"/>
                <field name="weight" options="{'no_open': true}" force_save="1" readonly="True"/>
                <field name="volume" options="{'no_open': true}" force_save="1" readonly="True"/>
                <field name="delivery_remainder" options="{'no_open': true}" force_save="1" readonly="True"/>
                <field name="consignment_remainder" options="{'no_open': true}" force_save="1" readonly="True"/>
                <field name="unit_price" options="{'no_open': true}" force_save="1" readonly="True"/>
                <field name="subtotal" options="{'no_open': true}" force_save="1" readonly="True"/>	
                <field name="delivery_date" options="{'no_open': true}" force_save="1" readonly="True"/>
                <field name="purchase_line_id" options="{'no_open': true}" force_save="1" column_invisible="1" readonly="True"/>
                <field name="concessional_rate" options="{'no_open': true}" force_save="1" column_invisible="1" readonly="True"/>
              </tree>
            </field>
          </group>
          <newline/>
          <footer>
            <button name="%(BugFix-Stock.action_imp_apply_selected_po_lines_to_consignment)d" string="Apply" type="action" class="oe_highlight"/>
            <button special="cancel" string="Cancel" class="oe_link"/>
          </footer>
      </form>
    </field>
  </record>
  <record id="view_imp_copy_po_line_to_consignment_inherit" model="ir.ui.view">
    <field name="name">Odoo Studio: IMP Copy PO Line to Consignment customization</field>
    <field name="model">temp_consignment_hea</field>
    <field name="inherit_id" ref="BugFix-Stock.view_ported_primary_form_temp_consignment_hea"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <data>
        <!-- v118: the attributes xpath on payment_method moved to BugFix-Purchase
             views/upstream_link_fields_views.xml (the field itself now comes from that module). -->
      </data>
    </field>
  </record>
</odoo>
