  </record>
    <record id="ported_view_5328_studio_stock_picking_type_form" model="ir.ui.view">
        <field name="name">Odoo Studio: Operation Types customization</field>
        <field name="model">stock.picking.type</field>
        <field name="type">form</field>
        <field name="priority">160</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//form[1]" position="attributes">
                <attribute name="create">false</attribute>
              </xpath>
              <xpath expr="//field[@name='sequence_id']" position="attributes">
                <attribute name="groups"/>
              </xpath>
              <xpath expr="//field[@name='create_backorder']" position="after">
                <field name="x_studio_movement_journal" string="Movement Journal"/>
                <field name="x_studio_mj_out" string="MJ OUT"/>
                <field name="x_studio_mj_in" string="MJ IN"/>
              </xpath>
            </data>
        </field>
    </record>
    <record id="ported_view_5334_studio_stock_picking_type_tree" model="ir.ui.view">
        <field name="name">Odoo Studio: Operation types customization</field>
        <field name="model">stock.picking.type</field>
        <field name="type">tree</field>
        <field name="priority">99</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="stock.view_picking_type_tree"/>
        <field name="arch" type="xml">
            <data>
              <xpath expr="//tree[1]/field[@name='name']" position="after">
                <field name="code" optional="show"/>
              </xpath>
              <xpath expr="//field[@name='warehouse_id']" position="after">
                <field name="sequence_code" optional="show"/>
              </xpath>
              <xpath expr="//field[@name='sequence_id']" position="attributes">
                <attribute name="groups"/>
              </xpath>
            </data>
        </field>
    </record>
