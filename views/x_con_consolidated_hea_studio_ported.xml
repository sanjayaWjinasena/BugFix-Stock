<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_default_form_view_fo_3e7b8355_c2a7_4eb8_a5b4_b080ccdddf7b" model="ir.ui.view">
    <field name="name">Default form view for x_con_consolidated_hea</field>
    <field name="model">x_con_consolidated_hea</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header>  
          
          
          
        </header>
        <header/>
        <sheet string="Con. Consolidated Header">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
          <field name="x_active" invisible="1"/>
          <div class="oe_title">
                      <span class="o_form_label">Con. Reference </span>
                      <h1>
                          <field name="x_name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_bc4ef6">
            <group name="studio_group_bc4ef6_left"/>
            <group name="studio_group_bc4ef6_right"/>
          </group>
        </sheet>
        <div class="oe_chatter" name="oe_chatter">
          <field name="message_follower_ids"/>
          <field name="message_ids"/>
          <field name="activity_ids"/>
        </div>
      </form>
    </field>
  </record>
  <record id="ported_odoo_studio_default__28be99a2_ccc7_4f0e_b80f_663aaf08af7f" model="ir.ui.view">
    <field name="name">Odoo Studio: Default form view for x_con_consolidated_hea customization</field>
    <field name="model">x_con_consolidated_hea</field>
    <field name="type">form</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="BugFix-Stock.ported_default_form_view_fo_3e7b8355_c2a7_4eb8_a5b4_b080ccdddf7b"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//button[@name='1414']" position="after">
          <field widget="statusbar" name="x_studio_pipeline_status_bar" string="Pipeline Status Bar"/>
        </xpath>
        <xpath expr="//form[1]/sheet[1]/div[1]/h1[1]/field[@name='x_name']" position="attributes">
          <attribute name="force_save">True</attribute>
          <attribute name="readonly">1</attribute></xpath>
        <xpath expr="//group[@name='studio_group_bc4ef6_left']" position="inside">
          <field name="x_studio_description" string="Description" readonly="x_studio_status == 'Confirmed'"/>
        </xpath>
        <xpath expr="//group[@name='studio_group_bc4ef6_right']" position="inside">
          <field name="create_uid"/>
          <field name="create_date"/>
          <field name="x_studio_status" string="Status" force_save="True" readonly="1"/>
          <field name="x_studio_company_id" string="Company" force_save="True" readonly="1" invisible="1"/>
          <field name="x_studio_lines_copied" string="Lines Copied" force_save="True" readonly="1" invisible="1"/>
        </xpath>
        <xpath expr="//group[@name='studio_group_bc4ef6']" position="after">
          <notebook name="studio_notebook_8O2sf">
            <page string="Lines" name="studio_page_8O2sf">
              <field name="x_studio_con_line_ids" string="Con. Line Ids" readonly="x_studio_status != 'Draft'">
                <tree create="false" edit="false">
                  <field name="x_studio_sequence" widget="handle" column_invisible="1"/>
                  <field name="x_studio_consignment_id" string="Consignment No" force_save="True" readonly="1"/>
                  <field name="x_studio_supplier_id" force_save="True" readonly="1"/>
                  <field name="x_studio_currency_id" force_save="True" readonly="1"/>
                  <field name="x_studio_delivery_term" force_save="True" readonly="1"/>
                  <field name="x_studio_supplier_invoice_no" force_save="True" readonly="1"/>
                  <field name="x_studio_container_no" force_save="True" readonly="1"/>
                  <field name="x_studio_custom_clearance_no" force_save="True" readonly="1"/>
                  <field name="x_studio_shipment_start_date" force_save="True" readonly="1" optional="hide"/>
                  <field name="x_studio_invoice_date" force_save="True" readonly="1" optional="hide"/>
                  <field name="x_studio_status" force_save="True" readonly="1" optional="hide"/>
                  <field name="x_studio_shipping_mode_1" force_save="True" readonly="1" optional="hide"/>
                  <field name="x_name" column_invisible="1"/>
                </tree>
              </field>
            </page>
          </notebook>
        </xpath>
      </data>
    </field>
  </record>
</odoo>
