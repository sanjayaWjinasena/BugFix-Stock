<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_default_form_view_fo_dbddc8a1_ea9d_47ba_8335_c08e4a53fc5c" model="ir.ui.view">
    <field name="name">Default form view for x_journal_types</field>
    <field name="model">x_journal_types</field>
    <field name="key">studio_customization.default_form_view_fo_dbddc8a1-ea9d-47ba-8335-c08e4a53fc5c</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="Journal Types">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
          <field name="x_active" invisible="1"/>
          <div class="oe_title">
                      <h1>
                          <field name="x_name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_3545bc">
            <group name="studio_group_3545bc_left"/>
            <group name="studio_group_3545bc_right"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="ported_default_list_view_fo_02152264_7fd7_4b5e_8a84_ca3714db9fad" model="ir.ui.view">
    <field name="name">Default list view for x_journal_types</field>
    <field name="model">x_journal_types</field>
    <field name="key">studio_customization.default_list_view_fo_02152264-7fd7-4b5e-8a84-ca3714db9fad</field>
    <field name="type">tree</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree>
        <field name="x_studio_sequence" widget="handle"/>
        <field name="x_name"/>
      </tree>
    </field>
  </record>
  <record id="ported_default_search_view__d3c181ad_9bc3_4cfc_9d60_2500bd38fe9f" model="ir.ui.view">
    <field name="name">Default search view for x_journal_types</field>
    <field name="model">x_journal_types</field>
    <field name="key">studio_customization.default_search_view__d3c181ad-9bc3-4cfc-9d60-2500bd38fe9f</field>
    <field name="type">search</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <search>
        <field name="x_name"/>
        <separator/>
        <filter string="Archived" name="archived_x_journal_types" domain="[['x_active', '=', False]]"/>
        <separator/>
      </search>
    </field>
  </record>
  <record id="ported_odoo_studio_default__7879380a_9ecc_4ca6_bfd3_fa82b991c3ce" model="ir.ui.view">
    <field name="name">Odoo Studio: Default list view for x_journal_types customization</field>
    <field name="model">x_journal_types</field>
    <field name="key">studio_customization.odoo_studio_default__7879380a-9ecc-4ca6-bfd3-fa82b991c3ce</field>
    <field name="type">tree</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="BugFix-Stock.ported_default_list_view_fo_02152264_7fd7_4b5e_8a84_ca3714db9fad"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//tree[1]" position="attributes">
          <attribute name="editable">bottom</attribute>
        </xpath>
        
        
      </data>
    </field>
  </record>
</odoo>
