<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_default_form_view_fo_6b5f65f9_e9e6_48d2_a1cf_f0ede8a5353b" model="ir.ui.view">
    <field name="name">Default form view for x_consignment_charge_h</field>
    <field name="model">x_consignment_charge_h</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="Consignment Charge Header">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
          <field name="x_active" invisible="1"/>
          <div class="oe_title">
                      <h1>
                          <field name="x_name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_99a601">
            <group name="studio_group_99a601_left"/>
            <group name="studio_group_99a601_right"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="ported_odoo_studio_default__f7a79ca0_c28b_426a_9cee_c3ad87d51662" model="ir.ui.view">
    <field name="name">Odoo Studio: Default form view for x_consignment_charge_h customization</field>
    <field name="model">x_consignment_charge_h</field>
    <field name="type">form</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="BugFix-Stock.ported_default_form_view_fo_6b5f65f9_e9e6_48d2_a1cf_f0ede8a5353b"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//group[@name='studio_group_99a601_left']" position="inside">
          <field name="x_studio_charge_group" string="Charge Group"/>
          <field name="x_studio_charge_name" string="Charge Name"/>
          <field name="x_studio_basis" string="Basis" invisible="1"/>
          <field name="x_studio_formula" string="Formula" invisible="1"/>
          <field name="x_studio_amount" string="Amount"/>
          <field name="x_studio_ledger_post" string="Ledger Post"/>
        </xpath>
        <xpath expr="//group[@name='studio_group_99a601_right']" position="inside">
          <field name="x_studio_consignment_id" string="Consignment Id" invisible="1"/>
          <field name="x_studio_structure_details_line_ids" string="Structure Details Line Ids" invisible="1"/>
          <field name="x_studio_structure_master_id" string="Structure Master Id" invisible="1"/>
          <field name="x_studio_structure_no" string="Structure No" invisible="1"/>
          <field name="x_studio_tax_appicable" string="Tax Appicable" invisible="1"/>
        </xpath>
      </data>
    </field>
  </record>
</odoo>
