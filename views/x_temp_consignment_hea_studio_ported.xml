              </tree>
            </field>
          </group>
          <newline/>
          <footer>
            
            <button special="cancel" string="Cancel" class="oe_link"/>
          </footer>
      </form>
    </field>
  </record>
  <record id="ported_odoo_studio_imp_copy_3c84c228_a129_41d2_b514_02ecd5397352" model="ir.ui.view">
