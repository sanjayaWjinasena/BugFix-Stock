<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_default_form_view_fo_2f8f86c0_4bf7_46a6_8629_ecbf71a8eb0c" model="ir.ui.view">
    <field name="name">Default form view for x_tariffmaster</field>
    <field name="model">x_tariffmaster</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="TariffMaster">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
          <field name="x_active" invisible="1"/>
          <div class="oe_title">
                      <h1>
                          <field name="x_name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_f8209d">
            <group name="studio_group_f8209d_left"/>
            <group name="studio_group_f8209d_right"/>
          </group>
        </sheet>
        <div class="oe_chatter" name="oe_chatter">
          <field name="message_follower_ids"/>
          <field name="message_ids"/>
          <field name="activity_ids"/>
        </div>
      </form>
    </field>
  </record>
  <record id="ported_odoo_studio_default__3291b05a_625c_4e34_8983_ad657ffc8e41" model="ir.ui.view">
    <field name="name">Odoo Studio: Default form view for x_tariffmaster customization</field>
    <field name="model">x_tariffmaster</field>
    <field name="type">form</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="BugFix-Stock.ported_default_form_view_fo_2f8f86c0_4bf7_46a6_8629_ecbf71a8eb0c"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//form[1]/sheet[1]/div[1]/h1[1]/field[@name='x_name']" position="attributes">
          <attribute name="string">Tarrif Code</attribute>
        </xpath>
        <xpath expr="//group[@name='studio_group_f8209d_left']" position="inside">
          <field name="x_studio_description" string="Description"/>
          <field name="x_studio_company_id" string="Company"/>
        </xpath>
        <xpath expr="//group[@name='studio_group_f8209d']" position="after">
          <notebook name="studio_notebook_T0Dw9">
            <page string="Date Range" name="studio_page_T0Dw9">
              <field name="x_studio_tariff_master_ids" string="Date Range">
                <tree>
                  <field name="x_studio_sequence" widget="handle" column_invisible="1"/>
                  <field name="x_studio_tarrif_from_date" required="1" force_save="1"/>
                  <field name="x_studio_tarrif_to_date"/>
                  <field name="x_studio_in_use"/>
                  <field name="x_name" column_invisible="1"/>
                </tree>
                <form edit="true">
                  <header/>
                  <sheet string="Tariff Date" name="studio_sheet_8f0cab">
                    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
                    <field name="x_active" invisible="1"/>
                    <div class="oe_title" name="studio_div_4bf90e">
                      <h1>
                        <field name="x_name" placeholder="Name..." invisible="1"/>
                      </h1>
                    </div>
                    <group name="studio_group_f1b3e3">
                      <group name="studio_group_f1b3e3_left">
                        <field name="x_studio_tarrif_from_date" string="From Date" required="1" force_save="1" readonly="x_studio_tarrif_from_date != False"/>
                        <field name="x_studio_tarrif_to_date" string="To Date" force_save="True" readonly="1"/>
                        <field name="x_studio_in_use" string="In Use" force_save="True" readonly="1"/>
                        <field name="x_studio_tariff_master_ids" string="Tariff Master Ids" invisible="1"/>
                      </group>
                      <group name="studio_group_f1b3e3_right"/>
                    </group>
                    <notebook name="studio_notebook_hNERC">
                      <page string="Rates" name="studio_page_hNERC">
                        <field name="x_studio_rates" string="Rates">
                          <tree create="false" editable="bottom" delete="false">
                            <field name="x_studio_sequence" widget="handle"/>
                            <field name="x_studio_charge_name" readonly="True"/>
                            <field name="x_studio_normal_rate"/>
                            <field name="x_studio_concessional_rate"/>
                            <field name="x_studio_misc_charge_line_id" string="Misc Charge Line Id" column_invisible="1"/>
                            <field name="x_studio_duties_line_id" string="Duties Line Id" column_invisible="1"/>
                            <field name="x_studio_taxes_line_id" string="Taxes Line Id" column_invisible="1"/>
                            <field name="x_name" column_invisible="1"/>
                          </tree>
                          <form>
                            <header/>
                            <sheet string="Tariff Rates" name="studio_sheet_d928d6">
                              <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
                              <field name="x_active" invisible="1"/>
                              <div class="oe_title" name="studio_div_b91016">
                                <h1>
                                  <field name="x_name" placeholder="Name..." invisible="1"/>
                                </h1>
                              </div>
                              <group name="studio_group_c3f574">
                                <group name="studio_group_c3f574_left">
                                  <field name="x_studio_charge_name" string="Charge Name"/>
                                  <field name="x_studio_normal_rate" string="Normal" help="Normal Duty/Tax percentage which will be multiplied by the  Assessable value to get the Duty/Tax amount of each item."/>
                                  <field name="x_studio_concessional_rate" string="Concessional" help="Concessional Duty/Tax percentage which will be multiplied by the  Assessable value to get the Duty/Tax amount of each item. This is applied in special occasions."/>
                                  <field name="x_studio_charge_group" string="Charge Group" help="The grouping which determines whether the line is a Charge, Duty or Tax."/>
                                  <field name="x_studio_tariff_date_ids" string="Tariff Date Ids" invisible="1"/>
                                </group>
                                <group name="studio_group_c3f574_right"/>
                              </group>
                            </sheet>
                          </form>
                        </field>
                      </page>
                    </notebook>
                  </sheet>
                </form>
              </field>
            </page>
          </notebook>
        </xpath>
      </data>
    </field>
  </record>
</odoo>
