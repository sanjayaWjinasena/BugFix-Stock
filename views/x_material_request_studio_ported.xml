<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_default_form_view_fo_6a77a64b_caff_42fe_97b4_e1d153c18e1b" model="ir.ui.view">
    <field name="name">Default form view for x_material_request</field>
    <field name="model">x_material_request</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header>  
          
          
          
          
          
          
        </header>
        <header/>
        <sheet string="Material Request">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
          <field name="x_active" invisible="1"/>
          <div class="oe_title">
                      <span class="o_form_label">Request Reference </span>
                      <h1>
                          <field name="x_name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_8ed6cf">
            <group name="studio_group_8ed6cf_left"/>
            <group name="studio_group_8ed6cf_right"/>
          </group>
        </sheet>
        <div class="oe_chatter" name="oe_chatter">
          <field name="message_follower_ids"/>
          <field name="message_ids"/>
          <field name="activity_ids"/>
        </div>
      </form>
    </field>
  </record>
  <record id="ported_odoo_studio_default__0da12c6e_f1ad_42c4_948e_050e0634075f" model="ir.ui.view">
    <field name="name">Odoo Studio: Default form view for x_material_request customization</field>
    <field name="model">x_material_request</field>
    <field name="type">form</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="BugFix-Stock.ported_default_form_view_fo_6a77a64b_caff_42fe_97b4_e1d153c18e1b"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//button[@name='2400']" position="after">
          <field widget="statusbar" name="x_studio_selection_field_BupKG" string="State" force_save="True" readonly="1"/>
        </xpath>
        <xpath expr="//form[1]/sheet[1]/widget[@name='web_ribbon']" position="before">
          <div name="button_box" class="oe_button_box">
            
          </div>
        </xpath>
        <xpath expr="//field[@name='x_name']" position="attributes">
          <attribute name="force_save">True</attribute>
          <attribute name="readonly">1</attribute><attribute name="required"/></xpath>
        <xpath expr="//group[@name='studio_group_8ed6cf_left']" position="inside">
          <field name="x_studio_warehouse" string="Warehouse" required="1" readonly="x_studio_selection_field_BupKG != 'Draft'"/>
          <field name="x_studio_many2one_field_6f0Gc" readonly="x_studio_selection_field_BupKG != 'Draft'"/>
          <field name="x_studio_notes" string="Notes" readonly="x_studio_selection_field_BupKG != 'Draft'"/>
          <field name="x_studio_requested_date" string="Requested Date" required="1" readonly="x_studio_selection_field_BupKG != 'Draft'"/>
        </xpath>
        <xpath expr="//group[@name='studio_group_8ed6cf_right']" position="inside">
          <field name="x_studio_many2one_field_THFu6" invisible="0" string="Maintenance Request No" force_save="True" readonly="1"/>
          <field name="x_studio_journal_type" string="Journal Type" force_save="True" readonly="1"/>
          <field name="create_uid" string="Created by" widget="many2one_avatar_user"/>
          <field name="create_date" string="Created on"/>
          <field name="x_studio_requested_by" string="Requested By" widget="many2one_avatar_user" required="1" readonly="x_studio_selection_field_BupKG != 'Draft'"/>
          <field name="x_studio_done_stage_updated" string="Done Stage Updated" force_save="True" readonly="1" invisible="1"/>
          <field name="x_studio_done" string="Done" force_save="True" readonly="1" invisible="1"/>
        </xpath>
        <xpath expr="//group[@name='studio_group_8ed6cf']" position="after">
          <notebook name="studio_notebook_PIcxd">
            <page string="Products" name="studio_page_PIcxd">
              <field name="x_studio_request_lines" force_save="True" readonly="(x_studio_selection_field_BupKG == 'Rejected') or (x_studio_selection_field_BupKG == 'Done')">
                <tree editable="bottom">
                  <field name="x_studio_sequence" widget="handle"/>
                  <field name="x_studio_product" optional="show" required="1" readonly="x_studio_status != 'Draft'"/>
                  <field name="x_studio_description_1" optional="show"/>
                  <field name="x_studio_warehouse" optional="show"/>
                  <field name="x_studio_uom_2" optional="show"/>
                  <field optional="show" name="x_studio_requested_by" string="Requested by" widget="many2one_avatar_user" required="1" readonly="x_studio_status != 'Draft'"/>
                  <field name="x_studio_quantity" optional="show" required="1" readonly="x_studio_status != 'Draft'"/>
                  <field optional="show" name="x_studio_qty_to_transfer" string="Qty. to Transfer"/>
                  <field name="x_studio_text_1" optional="hide" readonly="x_studio_status != 'Draft'"/>
                  <field optional="hide" name="x_studio_available_qty_to_transfer" string="Available Qty. to Transfer" force_save="True" readonly="1"/>
                  <field optional="hide" name="x_studio_qty_transfered" string="Qty. Transferred" force_save="True" readonly="1"/>
                  <field optional="hide" name="x_studio_transfer_remainder" string="Transfer Remainder" force_save="True" readonly="1"/>
                  <field optional="show" name="x_studio_status" string="Status" column_invisible="1"/>
                  <field optional="hide" name="x_studio_on_hand_qty_2" string="On Hand Qty"/>
                </tree>
                <form>
                  <header/>
                  <sheet string="MR config" name="studio_sheet_e06e4d">
                    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
                    <field name="x_active" invisible="1"/>
                    <div class="oe_title" name="studio_div_e096c6">
                      <h1>
                        <field name="x_name" required="1" placeholder="Name..." invisible="1"/>
                      </h1>
                    </div>
                    <group name="studio_group_e19aa9">
                      <group name="studio_group_e19aa9_left" string="General Information">
                        <field name="x_studio_product" required="1" readonly="x_studio_status != 'Draft'"/>
                        <field name="x_studio_description_1"/>
                        <field name="x_studio_warehouse"/>
                        <field name="x_studio_uom_2"/>
                        <field name="x_studio_quantity" required="1" readonly="x_studio_status != 'Draft'"/>
                        <field name="x_studio_many2one_field_6yqbk" invisible="1"/>
                      </group>
                      <group name="studio_group_e19aa9_right" string="Other Information">
                        <field name="x_studio_requested_by" required="1" widget="many2one_avatar_user" readonly="x_studio_status != 'Draft'"/>
                        <field name="x_studio_text_1" string="Notes" readonly="x_studio_status != 'Draft'"/>
                        <field name="x_studio_status"/>
                        <field name="x_studio_on_hand_qty_2"/>
                      </group>
                    </group>
                  </sheet>
                </form>
              </field>
            </page>
          </notebook>
        </xpath>
      </data>
    </field>
  </record>
</odoo>
