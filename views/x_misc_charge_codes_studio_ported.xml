<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_default_form_view_fo_79d2000d_8484_4cdb_befd_2dbcf0fb6a69" model="ir.ui.view">
    <field name="name">Default form view for x_misc_charge_codes</field>
    <field name="model">x_misc_charge_codes</field>
    <field name="key">studio_customization.default_form_view_fo_79d2000d-8484-4cdb-befd-2dbcf0fb6a69</field>
    <field name="type">form</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <form>
        <header/>
        <sheet string="Misc Charge Codes">
          <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
          <field name="x_active" invisible="1"/>
          <div class="oe_title">
                      <h1>
                          <field name="x_name" required="1" placeholder="Name..."/>
                      </h1>
                  </div>
          <group name="studio_group_d67062">
            <group name="studio_group_d67062_left"/>
            <group name="studio_group_d67062_right"/>
          </group>
        </sheet>
        
      </form>
    </field>
  </record>
  <record id="ported_default_list_view_fo_d3bfc8f6_5ce5_4404_9e14_e4e077d23300" model="ir.ui.view">
    <field name="name">Default list view for x_misc_charge_codes</field>
    <field name="model">x_misc_charge_codes</field>
    <field name="key">studio_customization.default_list_view_fo_d3bfc8f6-5ce5-4404-9e14-e4e077d23300</field>
    <field name="type">tree</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <tree>
        <field name="x_studio_sequence" widget="handle"/>
        <field name="x_name"/>
      </tree>
    </field>
  </record>
  <record id="ported_default_search_view__26c03071_07d8_4292_934f_fd75e2f5f6db" model="ir.ui.view">
    <field name="name">Default search view for x_misc_charge_codes</field>
    <field name="model">x_misc_charge_codes</field>
    <field name="key">studio_customization.default_search_view__26c03071-07d8-4292-934f-fd75e2f5f6db</field>
    <field name="type">search</field>
    <field name="priority">16</field>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <search>
        <field name="x_name"/>
        <separator/>
        <filter string="Archived" name="archived_x_misc_charge_codes" domain="[['x_active', '=', False]]"/>
        <separator/>
      </search>
    </field>
  </record>
